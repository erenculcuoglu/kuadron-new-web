---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';

export async function getStaticPaths() {
  const toAsciiSlug = (str: string): string => {
    const map: Record<string, string> = {
      ç: 'c', ğ: 'g', ı: 'i', i: 'i', ö: 'o', ş: 's', ü: 'u',
    };
    return str
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[çğıöşü]/g, (c) => map[c] || c)
      .replace(/[^a-z0-9-]+/g, '-')
      .replace(/^-+|-+$/g, '');
  };

  const posts = (await getCollection('blog')).sort((a, b) =>
    b.data.pubDate.localeCompare(a.data.pubDate)
  );

  const tagMap = new Map<string, { label: string; posts: CollectionEntry<'blog'>[] }>();

  const registerTag = (slug: string, label: string, post: CollectionEntry<'blog'>) => {
    if (!slug) return;
    const entry = tagMap.get(slug);
    if (entry) {
      if (!entry.posts.some((p) => p.id === post.id)) {
        entry.posts.push(post);
      }
    } else {
      tagMap.set(slug, { label, posts: [post] });
    }
  };

  for (const post of posts) {
    for (const t of post.data.tags) {
      registerTag(t.slug, t.label, post);
      const ascii = toAsciiSlug(t.slug);
      if (ascii && ascii !== t.slug) {
        registerTag(ascii, t.label, post);
      }
    }
  }

  // Ensure legacy 2021 sitemap tag URLs also resolve cleanly
  const legacySitemapTags = [
    'erp', 'kosgeb', 'hibe', 'destek', 'program', 'saas', 'pandemi',
    'bayi-otomasyon', 'bayi', 'otomasyon', 'kalite', 'kys', 'endustri-4-0',
  ];
  for (const lt of legacySitemapTags) {
    if (!tagMap.has(lt)) {
      tagMap.set(lt, { label: lt.toUpperCase(), posts: posts.slice(0, 6) });
    }
  }

  return Array.from(tagMap.entries()).map(([tagSlug, data]) => ({
    params: { tag: tagSlug },
    props: { tagLabel: data.label, posts: data.posts },
  }));
}

interface Props {
  tagLabel: string;
  posts: CollectionEntry<'blog'>[];
}

const { tagLabel, posts } = Astro.props;
---

<BaseLayout
  lang="tr"
  title={`#${tagLabel} Yazıları | Kuadron Blog`}
  description={`Kuadron Blog üzerinde "${tagLabel}" etiketiyle yayınlanan tüm teknoloji ve iş yazılımı rehberleri.`}
>
  <PageHero
    lang="tr"
    eyebrow="Blog Etiketi"
    title={`#${tagLabel}`}
    lead={`Bu etikete ait toplam ${posts.length} içerik listeleniyor.`}
  />

  <section class="py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <a href="/blog" class="k-btn-secondary !min-h-10 !px-4 !py-2 !text-xs">
          <Icon name="arrow-left" class="h-4 w-4" />
          <span>Tüm Blog Yazılarına Dön</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-7 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="k-card k-card-hover flex flex-col justify-between overflow-hidden">
            <div>
              <a
                href={`/blog/${post.id}`}
                class="block aspect-[16/10] overflow-hidden border-b border-[var(--border-subtle)] bg-[var(--bg-subtle)]"
              >
                <img
                  src={post.data.coverImage}
                  alt={post.data.title}
                  loading="lazy"
                  width="480"
                  height="300"
                  class="h-full w-full object-cover"
                />
              </a>
              <div class="p-6">
                <p class="text-xs text-[var(--text-muted)]">
                  {post.data.displayDate} • {post.data.readingTime} dk okuma
                </p>
                <h2 class="mt-2.5 line-clamp-2 text-xl font-bold text-[var(--text-primary)]">
                  <a href={`/blog/${post.id}`} class="hover:text-[var(--brand-sky)]">
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-2.5 line-clamp-3 text-sm leading-relaxed text-[var(--text-secondary)]">
                  {post.data.description}
                </p>
              </div>
            </div>

            <div class="border-t border-[var(--border-subtle)] px-6 py-4">
              <a
                href={`/blog/${post.id}`}
                class="inline-flex items-center gap-1.5 text-sm font-bold text-[var(--brand-sky)] hover:text-[var(--brand-amber-text)]"
              >
                <span>Yazıyı Oku</span>
                <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
