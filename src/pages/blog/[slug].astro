---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ContactSection from '../../components/ContactSection.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const byId = new Map(posts.map((p) => [p.id, p]));

  const paths: Array<{
    params: { slug: string };
    props: { post: CollectionEntry<'blog'>; allPosts: CollectionEntry<'blog'>[] };
  }> = posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));

  // Legacy 2021 sitemap & clean URL aliases so historic search links never 404
  const legacyAliases: Record<string, string> = {
    'yeni-nesil-sirket-yonetim-uygulamasi-gelistirdi': 'kuadron-bilisim-torkapp',
    'endustri-4-0-nedir-ve-amaci-nedir': 'endustri-4-0-nedir',
    'yazilim-gelistirme-yapan-firmalar': 'yazilim-firmalari',
    'kuadron-veri-hazirlama-uygulamasi-reportqli-duyurdu': 'autosave-a6490db0181a61ee92ded505d349363b',
  };

  for (const [aliasSlug, targetId] of Object.entries(legacyAliases)) {
    const target = byId.get(targetId);
    if (target && !byId.has(aliasSlug)) {
      paths.push({
        params: { slug: aliasSlug },
        props: { post: target, allPosts: posts },
      });
    }
  }

  return paths;
}

interface Props {
  post: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth === 2);

const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    const sharedA = a.data.tags.filter((t) => post.data.tags.some((pt) => pt.slug === t.slug)).length;
    const sharedB = b.data.tags.filter((t) => post.data.tags.some((pt) => pt.slug === t.slug)).length;
    if (sharedB !== sharedA) return sharedB - sharedA;
    return b.data.pubDate.localeCompare(a.data.pubDate);
  })
  .slice(0, 3);

const siteOrigin = Astro.site?.origin || 'https://www.kuadron.com';
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: `${siteOrigin}${post.data.coverImage}`,
  datePublished: post.data.pubDate,
  author: {
    '@type': 'Person',
    name: post.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Kuadron Bilişim Teknolojileri',
    logo: {
      '@type': 'ImageObject',
      url: `${siteOrigin}/assets/icons/android-icon-192x192.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${siteOrigin}/blog/${post.id}/`,
  },
};
---

<BaseLayout
  lang="tr"
  title={post.data.metaTitle}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}/`}
  ogImage={post.data.coverImage}
  ogType="article"
  jsonLd={articleJsonLd}
>
  <article class="py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-2 text-xs font-medium text-[var(--text-muted)]">
          <li><a href="/" class="hover:text-[var(--text-primary)]">Ana Sayfa</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/blog" class="hover:text-[var(--text-primary)]">Blog</a></li>
          <li aria-hidden="true">/</li>
          <li class="truncate font-semibold text-[var(--text-primary)]" aria-current="page">
            {post.data.title}
          </li>
        </ol>
      </nav>

      <!-- Tags -->
      <div class="flex flex-wrap items-center gap-2">
        {post.data.tags.map((t) => (
          <a
            href={`/blog/tag/${encodeURIComponent(t.slug)}`}
            class="rounded-full bg-[var(--brand-amber-bg)] px-3 py-1 font-mono text-xs font-semibold text-[var(--brand-amber-text)] transition-opacity hover:opacity-85"
          >
            #{t.label}
          </a>
        ))}
      </div>

      <!-- Title -->
      <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-[var(--text-primary)] sm:text-5xl">
        {post.data.title}
      </h1>

      <!-- Author & Date Meta -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-y border-[var(--border-subtle)] py-4">
        <div class="flex items-center gap-3">
          <img
            src={post.data.authorAvatar}
            alt={post.data.author}
            width="44"
            height="44"
            class="h-11 w-11 rounded-full border border-[var(--border-subtle)] object-cover"
          />
          <div>
            <p class="text-sm font-bold text-[var(--text-primary)]">{post.data.author}</p>
            <div class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
              <time datetime={post.data.pubDate}>{post.data.displayDate}</time>
              <span aria-hidden="true">•</span>
              <span>{post.data.readingTime} dk okuma süresi</span>
            </div>
          </div>
        </div>

        <a href="/blog" class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--brand-sky)] hover:underline">
          <Icon name="arrow-left" class="h-4 w-4" />
          <span>Tüm Blog Yazıları</span>
        </a>
      </div>

      <!-- Featured Cover Image (LCP Candidate -> fetchpriority="high") -->
      <div class="mt-8 overflow-hidden rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)] shadow-md">
        <img
          src={post.data.coverImage}
          alt={post.data.title}
          fetchpriority="high"
          width="960"
          height="540"
          class="aspect-[16/9] w-full object-cover"
        />
      </div>

      <!-- Optional Table of Contents if post has >=2 H2 headings -->
      {tocHeadings.length >= 2 && (
        <nav
          aria-label="İçindekiler"
          class="mt-8 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)] p-5 sm:p-6"
        >
          <p class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--brand-amber-text)]">
            İçindekiler
          </p>
          <ul class="mt-3 space-y-2 text-sm font-medium">
            {tocHeadings.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class="inline-flex items-center gap-2 text-[var(--text-secondary)] transition-colors hover:text-[var(--brand-sky)]"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-[#FBB040]"></span>
                  <span>{h.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <!-- Article Markdown Content -->
      <div class="prose-kuadron mt-10">
        <Content />
      </div>

      <!-- Bottom Tags & Share -->
      <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--border-subtle)] pt-6">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold text-[var(--text-muted)]">Etiketler:</span>
          {post.data.tags.map((t) => (
            <a
              href={`/blog/tag/${encodeURIComponent(t.slug)}`}
              class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-subtle)] px-3 py-1 text-xs font-semibold text-[var(--text-secondary)] hover:border-[var(--brand-amber)]"
            >
              #{t.label}
            </a>
          ))}
        </div>

        <a href="/#iletisim" class="k-btn-amber !min-h-10 !px-4 !py-2 !text-xs">
          <span>Projeniz İçin Bize Ulaşın</span>
          <Icon name="arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
  </article>

  <!-- Related Posts -->
  {relatedPosts.length > 0 && (
    <section class="border-t border-[var(--border-subtle)] bg-[var(--bg-subtle)] py-14 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-3xl">
          Benzer Yazılar
        </h2>

        <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
          {relatedPosts.map((rp) => (
            <article class="k-card k-card-hover flex flex-col justify-between overflow-hidden">
              <div>
                <a
                  href={`/blog/${rp.id}`}
                  class="block aspect-[16/10] overflow-hidden border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]"
                >
                  <img
                    src={rp.data.coverImage}
                    alt={rp.data.title}
                    loading="lazy"
                    width="440"
                    height="275"
                    class="h-full w-full object-cover"
                  />
                </a>
                <div class="p-5">
                  <p class="text-xs text-[var(--text-muted)]">{rp.data.displayDate}</p>
                  <h3 class="mt-2 line-clamp-2 text-lg font-bold text-[var(--text-primary)]">
                    <a href={`/blog/${rp.id}`} class="hover:text-[var(--brand-sky)]">
                      {rp.data.title}
                    </a>
                  </h3>
                  <p class="mt-2 line-clamp-2 text-sm text-[var(--text-secondary)]">
                    {rp.data.description}
                  </p>
                </div>
              </div>
              <div class="px-5 pb-5">
                <a
                  href={`/blog/${rp.id}`}
                  class="inline-flex items-center gap-1 text-sm font-bold text-[var(--brand-sky)] hover:text-[var(--brand-amber-text)]"
                >
                  <span>Yazıyı Oku</span>
                  <Icon name="arrow-right" class="h-4 w-4" />
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <ContactSection lang="tr" />
</BaseLayout>
