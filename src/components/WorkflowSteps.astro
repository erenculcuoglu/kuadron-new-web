---
import Icon from './Icon.astro';
import type { WorkflowStep } from '../data/types';

interface Props { title: string; subtitle: string; steps: WorkflowStep[] }
const { title, subtitle, steps } = Astro.props;
---

<section class="workflow-section py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
      <p class="mt-4 text-[var(--text-secondary)]">{subtitle}</p>
    </div>
    <ol class="workflow-list" role="list">
      {steps.map((step, index) => (
        <li class="workflow-step">
          <div class="workflow-node">
            <span class="workflow-number">{step.number}</span>
            {index < steps.length - 1 && <Icon name="arrow-right" class="workflow-arrow h-5 w-5" />}
          </div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
