---
import OzbiFlow from './OzbiFlow.astro';
import type { Locale, ProductItem } from '../data/types';

interface Props { product: ProductItem; lang: Locale }
const { product, lang } = Astro.props;
if (!product.image && product.visual !== 'ozbi-flow') {
  throw new Error(`Missing product visual: ${product.id}`);
}
---

<div class:list={['product-visual', product.visual === 'ozbi-flow' && 'product-visual-ozbi']}>
  {product.visual === 'ozbi-flow'
    ? <OzbiFlow lang={lang} />
    : <img src={product.image} alt={`${product.name} — ${product.tagline}`} width={product.imageWidth || 640} height={product.imageHeight || 360} loading="lazy" />}
</div>
