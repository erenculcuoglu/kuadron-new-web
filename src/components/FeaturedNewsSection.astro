---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { SITE_CONTENT } from '../data/site-content';
import type { Locale } from '../data/types';

interface Props { lang: Locale }
const { lang } = Astro.props;
const news = SITE_CONTENT[lang].featuredNewsSection;
---

<section class="editorial-section">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow={news.eyebrow} title={news.title} href={news.viewAllHref} linkLabel={news.viewAllLabel} />
    <div class="press-grid">
      {news.cards.map((card) => (
        <article class="editorial-story">
          <img src={card.image} alt="" width="420" height="260" loading="lazy" class="story-image" />
          <p class="section-label">{card.source}</p>
          <h3><a href={card.url} target="_blank" rel="noopener noreferrer nofollow">{card.title}</a></h3>
          <p class="section-description">{card.excerpt}</p>
          <a href={card.url} target="_blank" rel="noopener noreferrer nofollow" class="editorial-link">{card.ctaLabel}<Icon name="external" class="h-4 w-4" /></a>
        </article>
      ))}
    </div>
  </div>
</section>
