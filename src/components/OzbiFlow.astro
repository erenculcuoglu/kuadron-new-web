---
import Icon from './Icon.astro';
import type { Locale } from '../data/types';

interface Props { lang: Locale }
const { lang } = Astro.props;
const copy = lang === 'tr'
  ? {
      label: 'OzBI nasıl çalışır?',
      example: 'Örnek soru',
      question: 'Tahsilatı geciken müşteriler hangileri?',
      steps: [
        { title: 'ERP veriniz', detail: 'Logo, Mikro veya SQL' },
        { title: 'OzBI analizi', detail: 'Doğal dilde sorgu' },
        { title: 'Karar desteği', detail: 'Tablo, grafik ve analiz' },
      ],
    }
  : {
      label: 'How does OzBI work?',
      example: 'Example question',
      question: 'Which customers have overdue payments?',
      steps: [
        { title: 'Your ERP data', detail: 'Logo, Mikro or SQL' },
        { title: 'OzBI analysis', detail: 'Ask in plain language' },
        { title: 'Decision support', detail: 'Tables, charts and analysis' },
      ],
    };
---

<figure class="ozbi-flow" aria-label={copy.label}>
  <div class="ozbi-question">
    <p class="section-label">{copy.example}</p>
    <p>“{copy.question}”</p>
  </div>
  <ol class="ozbi-flow-steps" role="list">
    {copy.steps.map((step, index) => (
      <li>
        <div class="ozbi-flow-node">
          <span class="ozbi-flow-number" aria-hidden="true">0{index + 1}</span>
          <strong>{step.title}</strong>
          <span>{step.detail}</span>
        </div>
        {index < copy.steps.length - 1 && <Icon name="arrow-right" class="ozbi-flow-arrow h-4 w-4" />}
      </li>
    ))}
  </ol>
</figure>
