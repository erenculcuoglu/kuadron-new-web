---
import KuadronLogo from './KuadronLogo.astro';
import Icon from './Icon.astro';
import { SITE_CONTENT } from '../data/site-content';
import { getAlternateUrl } from '../config/routes';
import { type Locale } from '../data/types';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const content = SITE_CONTENT[lang];
const pathname = Astro.url.pathname;
const altHref = getAlternateUrl(pathname, content.altLang);
const homeHref = lang === 'tr' ? '/' : '/en/';

function isActive(href: string) {
  if (href.includes('#')) return false;
  const cleanPath = pathname.replace(/\/+$/, '') || '/';
  const cleanHref = href.replace(/\/+$/, '') || '/';
  if (cleanHref === '/blog') return cleanPath.startsWith('/blog');
  return cleanPath === cleanHref;
}

const isCorporateActive = content.nav.corporateItems.some((item) => isActive(item.href));
const isServicesActive = content.nav.servicesItems.some((item) => isActive(item.href));
---

<header
  class="sticky top-0 z-50 border-b border-[var(--border-subtle)] bg-[color-mix(in_oklab,var(--bg-surface),transparent_12%)] backdrop-blur-md"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a
      href={homeHref}
      class="site-brand inline-flex min-w-0 items-center gap-2 text-[var(--text-primary)] transition-opacity hover:opacity-90"
      aria-label={content.siteName}
    >
      <KuadronLogo class="h-8 w-auto sm:h-9" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label={lang === 'tr' ? 'Ana menü' : 'Main navigation'}>
      <!-- Corporate Dropdown -->
      <details class="group relative nav-disclosure" name="desktop-navigation">
        <summary
          class:list={[
            'inline-flex min-h-11 items-center gap-1.5 rounded-lg px-3.5 py-2 text-sm font-semibold transition-colors',
            isCorporateActive
              ? 'bg-[var(--brand-amber-bg)] text-[var(--brand-amber-text)]'
              : 'text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-primary)]',
          ]}
        >
          <span>{content.nav.corporateLabel}</span>
          <Icon name="chevron-down" class="h-4 w-4 transition-transform duration-200 group-open:rotate-180" />
        </summary>
        <div
          class="absolute left-0 top-full z-50 w-80 pt-2"
        >
          <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-elevated)] p-2 shadow-xl">
            {content.nav.corporateItems.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded-xl px-3.5 py-2.5 transition-colors',
                  isActive(item.href)
                    ? 'bg-[var(--brand-amber-bg)] text-[var(--brand-amber-text)]'
                    : 'hover:bg-[var(--bg-subtle)]',
                ]}
              >
                <div class="text-sm font-semibold text-[var(--text-primary)]">{item.label}</div>
                <div class="mt-0.5 text-xs leading-snug text-[var(--text-muted)]">{item.desc}</div>
              </a>
            ))}
          </div>
        </div>
      </details>

      <!-- Services Dropdown -->
      <details class="group relative nav-disclosure" name="desktop-navigation">
        <summary
          class:list={[
            'inline-flex min-h-11 items-center gap-1.5 rounded-lg px-3.5 py-2 text-sm font-semibold transition-colors',
            isServicesActive
              ? 'bg-[var(--brand-amber-bg)] text-[var(--brand-amber-text)]'
              : 'text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-primary)]',
          ]}
        >
          <span>{content.nav.servicesLabel}</span>
          <Icon name="chevron-down" class="h-4 w-4 transition-transform duration-200 group-open:rotate-180" />
        </summary>
        <div
          class="absolute left-0 top-full z-50 w-88 pt-2"
        >
          <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-elevated)] p-2 shadow-xl">
            {content.nav.servicesItems.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded-xl px-3.5 py-2.5 transition-colors',
                  isActive(item.href)
                    ? 'bg-[var(--brand-amber-bg)] text-[var(--brand-amber-text)]'
                    : 'hover:bg-[var(--bg-subtle)]',
                ]}
              >
                <div class="text-sm font-semibold text-[var(--text-primary)]">{item.label}</div>
                <div class="mt-0.5 text-xs leading-snug text-[var(--text-muted)]">{item.desc}</div>
              </a>
            ))}
          </div>
        </div>
      </details>

      <!-- Direct Nav Links -->
      {content.nav.directLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-11 items-center rounded-lg px-3.5 py-2 text-sm font-semibold transition-colors',
            isActive(link.href)
              ? 'bg-[var(--brand-amber-bg)] text-[var(--brand-amber-text)]'
              : 'text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-primary)]',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Actions: Lang Switcher, Theme Toggle, CTA, Mobile Menu -->
    <div class="flex items-center gap-2">
      <!-- Language Switcher -->
      <a
        href={altHref}
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)] px-3 text-xs font-bold tracking-wider text-[var(--text-primary)] transition-colors hover:border-[var(--brand-amber)]"
        hreflang={content.altLang}
        aria-label={content.altLang === 'en' ? 'Switch to English' : 'Türkçe diline geç'}
      >
        {content.langLabel}
      </a>

      <!-- Two-state Dark Mode Toggle (CSS-driven state labels) -->
      <button
        type="button"
        data-theme-toggle
        class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)] text-[var(--text-primary)] transition-colors hover:border-[var(--brand-amber)]"
      >
        <span class="theme-toggle-dark-label items-center justify-center">
          <Icon name="moon" class="h-4.5 w-4.5" />
          <span class="visually-hidden">{content.nav.themeSwitchToDark}</span>
        </span>
        <span class="theme-toggle-light-label items-center justify-center">
          <Icon name="sun" class="h-4.5 w-4.5 text-[#FBB040]" />
          <span class="visually-hidden">{content.nav.themeSwitchToLight}</span>
        </span>
      </button>

      <!-- Desktop Primary CTA -->
      <a href={content.nav.ctaHref} class="k-btn-primary hidden !min-h-11 !px-4 !py-2 !text-sm sm:inline-flex">
        <span>{content.nav.ctaButton}</span>
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>

      <!-- Mobile Menu Trigger -->
      <button
        type="button"
        data-open-dialog="mobile-nav-dialog"
        class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-subtle)] text-[var(--text-primary)] lg:hidden"
        aria-label={content.nav.openMenu}
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>
</header>

<!-- Native Top-Layer Mobile Navigation Drawer with Light Dismiss -->
<dialog
  id="mobile-nav-dialog"
  closedby="any"
  aria-label={lang === 'tr' ? 'Mobil Gezinme Menüsü' : 'Mobile Navigation Menu'}
  class="k-drawer"
>
  <div class="flex h-full flex-col justify-between overflow-y-auto p-6">
    <div>
      <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-4">
        <a href={homeHref} class="text-[var(--text-primary)]" data-close-dialog>
          <KuadronLogo class="h-7 w-auto" />
        </a>
        <form method="dialog">
          <button
            type="submit"
            class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-xl border border-[var(--border-subtle)] text-[var(--text-primary)]"
            aria-label={content.nav.closeMenu}
          >
            <Icon name="close" class="h-5 w-5" />
          </button>
        </form>
      </div>

      <div class="mt-6 space-y-6">
        <div>
          <p class="px-2 font-mono text-xs font-semibold uppercase tracking-wider text-[var(--brand-amber-text)]">
            {content.nav.corporateLabel}
          </p>
          <ul class="mt-2 space-y-1">
            {content.nav.corporateItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-close-dialog
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-xl px-3 py-2.5 text-base font-semibold transition-colors',
                    isActive(item.href)
                      ? 'bg-[var(--brand-amber-bg)] text-[var(--brand-amber-text)]'
                      : 'text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="px-2 font-mono text-xs font-semibold uppercase tracking-wider text-[var(--brand-amber-text)]">
            {content.nav.servicesLabel}
          </p>
          <ul class="mt-2 space-y-1">
            {content.nav.servicesItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-close-dialog
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-xl px-3 py-2.5 text-base font-semibold transition-colors',
                    isActive(item.href)
                      ? 'bg-[var(--brand-amber-bg)] text-[var(--brand-amber-text)]'
                      : 'text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="border-t border-[var(--border-subtle)] pt-4">
          <ul class="space-y-1">
            {content.nav.directLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-close-dialog
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-xl px-3 py-2.5 text-base font-semibold',
                    isActive(link.href)
                      ? 'bg-[var(--brand-amber-bg)] text-[var(--brand-amber-text)]'
                      : 'text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-8 border-t border-[var(--border-subtle)] pt-5">
      <a href={content.nav.ctaHref} data-close-dialog class="k-btn-amber w-full">
        <span>{content.nav.ctaButton}</span>
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</dialog>

<style>
  @media (max-width: 639px) {
    .site-brand { width: min(10rem, calc(100vw - 12rem)); }
    .site-brand :global(svg) { width: 100%; height: auto; }
  }
  .nav-disclosure > summary { cursor: pointer; list-style: none; }
  .nav-disclosure > summary::-webkit-details-marker { display: none; }
</style>
<script>
  const disclosures = document.querySelectorAll<HTMLDetailsElement>('.nav-disclosure');
  disclosures.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (item.open) disclosures.forEach((other) => { if (other !== item) other.open = false; });
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const active = document.activeElement;
    disclosures.forEach((item) => {
      if (!item.open) return;
      item.open = false;
      if (active && item.contains(active)) item.querySelector('summary')?.focus();
    });
  });
  document.addEventListener('click', (event) => {
    disclosures.forEach((item) => {
      if (event.target instanceof Node && !item.contains(event.target)) item.open = false;
    });
  });
</script>
