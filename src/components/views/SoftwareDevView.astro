---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import WorkflowSteps from '../WorkflowSteps.astro';
import ProjectShowcase from '../ProjectShowcase.astro';
import FeaturedNewsSection from '../FeaturedNewsSection.astro';
import ContactSection from '../ContactSection.astro';
import { SITE_CONTENT } from '../../data/site-content';
import { type Locale } from '../../data/types';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const s = SITE_CONTENT[lang].softwareDev;
const projects = SITE_CONTENT[lang].projects;
---

<BaseLayout lang={lang} title={s.metaTitle} description={s.metaDescription}>
  <PageHero lang={lang} eyebrow={s.eyebrow} title={s.title} lead={s.lead} />

  <WorkflowSteps title={s.workflowTitle} subtitle={s.workflowSubtitle} steps={s.steps} />

  <section class="border-y border-[var(--border-subtle)] bg-[var(--bg-subtle)] py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <span class="inline-flex items-center gap-2 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3.5 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-[var(--brand-amber-text)]">
          <span class="h-1.5 w-1.5 rounded-full bg-[#FBB040]"></span>
          {lang === 'tr' ? 'Portföy' : 'Portfolio'}
        </span>
        <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl">
          {s.projectsTitle}
        </h2>
      </div>

      <ProjectShowcase items={projects} />
    </div>
  </section>

  <FeaturedNewsSection lang={lang} />
  <ContactSection lang={lang} />
</BaseLayout>
