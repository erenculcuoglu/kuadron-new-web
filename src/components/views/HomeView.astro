---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialsSection from '../TestimonialsSection.astro';
import FeaturedNewsSection from '../FeaturedNewsSection.astro';
import ContactSection from '../ContactSection.astro';
import HomeHero from '../home/HomeHero.astro';
import HomeServices from '../home/HomeServices.astro';
import HomeApproach from '../home/HomeApproach.astro';
import HomeProducts from '../home/HomeProducts.astro';
import HomeProjects from '../home/HomeProjects.astro';
import HomeArticles from '../home/HomeArticles.astro';
import NewsletterSection from '../home/NewsletterSection.astro';
import { SITE_CONTENT } from '../../data/site-content';
import type { Locale } from '../../data/types';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = SITE_CONTENT[lang];
const h = t.home;
---

<BaseLayout lang={lang} title={h.metaTitle} description={h.metaDescription}>
  <HomeHero lang={lang} />
  <HomeServices lang={lang} />
  <HomeApproach lang={lang} />
  <HomeProducts lang={lang} />
  <HomeProjects lang={lang} />
  <TestimonialsSection
    eyebrow={h.testimonialsEyebrow}
    title={h.testimonialsTitle}
    testimonials={t.testimonials}
    prevLabel={lang === 'tr' ? 'Önceki müşteri yorumu' : 'Previous testimonial'}
    nextLabel={lang === 'tr' ? 'Sonraki müşteri yorumu' : 'Next testimonial'}
  />
  <FeaturedNewsSection lang={lang} />
  <HomeArticles lang={lang} />
  <NewsletterSection lang={lang} />
  <ContactSection lang={lang} />
</BaseLayout>
