---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import WorkflowSteps from '../WorkflowSteps.astro';
import FeaturedNewsSection from '../FeaturedNewsSection.astro';
import ContactSection from '../ContactSection.astro';
import { SITE_CONTENT } from '../../data/site-content';
import { type Locale } from '../../data/types';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = SITE_CONTENT[lang].digitalTransformation;
---

<BaseLayout lang={lang} title={d.metaTitle} description={d.metaDescription}>
  <PageHero lang={lang} eyebrow={d.eyebrow} title={d.title} lead={d.lead} />

  <WorkflowSteps title={d.workflowTitle} subtitle={d.workflowSubtitle} steps={d.steps} />

  <FeaturedNewsSection lang={lang} />
  <ContactSection lang={lang} />
</BaseLayout>
