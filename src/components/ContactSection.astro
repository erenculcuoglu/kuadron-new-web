---
import Icon from './Icon.astro';
import { SITE_CONTENT } from '../data/site-content';
import { COMPANY_INFO } from '../config/company';
import { type Locale } from '../data/types';

interface Props {
  lang: Locale;
  idPrefix?: string;
}

const { lang, idPrefix = 'main-contact' } = Astro.props;
const c = SITE_CONTENT[lang].contact;
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '';
---

<section id={c.anchor} class="border-t border-[var(--border-subtle)] bg-[var(--bg-subtle)] py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
      <!-- Left Info & Office Card -->
      <div class="flex flex-col justify-between lg:col-span-5">
        <div>
          <p class="section-label">{c.eyebrow}</p>
          <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl">
            {c.title}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)]">
            {c.description}
          </p>

          <div class="mt-8 space-y-4">
            <div class="contact-address">
              <p class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--brand-amber-text)]">
                {c.addressTitle}
              </p>
              <p class="mt-2 text-sm font-medium leading-relaxed text-[var(--text-primary)]">
                {COMPANY_INFO.addressLines.join(', ')}
              </p>
              <a
                href={COMPANY_INFO.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-1.5 text-sm font-bold text-[var(--brand-sky)] hover:underline"
              >
                <Icon name="map-pin" class="h-4 w-4" />
                <span>{c.mapLabel}</span>
                <Icon name="external" class="h-3.5 w-3.5" />
              </a>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <a
                href={COMPANY_INFO.phoneHref}
                class="contact-detail"
              >
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded bg-[var(--brand-amber-bg)] text-[var(--brand-amber-text)]">
                  <Icon name="phone" class="h-5 w-5" />
                </span>
                <div>
                  <span class="block text-xs text-[var(--text-muted)]">
                    {lang === 'tr' ? 'Telefon' : 'Phone'}
                  </span>
                  <span class="text-sm font-bold text-[var(--text-primary)]">{COMPANY_INFO.phoneDisplay}</span>
                </div>
              </a>

              <a
                href={`mailto:${COMPANY_INFO.email}`}
                class="contact-detail"
              >
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded bg-[var(--brand-sky-bg)] text-[var(--brand-sky)]">
                  <Icon name="mail" class="h-5 w-5" />
                </span>
                <div class="min-w-0">
                  <span class="block text-xs text-[var(--text-muted)]">E-mail</span>
                  <span class="block truncate text-sm font-bold text-[var(--text-primary)]">{COMPANY_INFO.email}</span>
                </div>
              </a>
            </div>
          </div>
        </div>

        <div class="mt-8">
          <a
            href={COMPANY_INFO.jotform.contact}
            target="_blank"
            rel="noopener noreferrer"
            class="k-btn-secondary w-full sm:w-auto"
          >
            <span>{c.jotformButton}</span>
            <Icon name="external" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Right Native Accessible Contact Form -->
      <div class="lg:col-span-7">
        <div class="contact-form">
          <h3 class="text-xl font-bold text-[var(--text-primary)]">{c.formTitle}</h3>

          <form
            action={contactEndpoint || `mailto:${COMPANY_INFO.email}`}
            method="POST"
            data-kuadron-form
            data-endpoint={contactEndpoint}
            data-fallback-email={COMPANY_INFO.email}
            data-submitting-text={c.submittingLabel}
            data-submit-text={c.submitLabel}
            data-success-text={c.successMessage}
            data-fallback-text={c.fallbackNotice}
            class="mt-6 space-y-5"
          >
            <!-- Honeypot spam trap -->
            <div class="visually-hidden" aria-hidden="true">
              <label for={`${idPrefix}-company-website`}>Website</label>
              <input type="text" id={`${idPrefix}-company-website`} name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <div>
              <label for={`${idPrefix}-name`} class="mb-1.5 block text-sm font-semibold text-[var(--text-primary)]">
                {c.nameLabel} <span class="text-[var(--status-error)]" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id={`${idPrefix}-name`}
                name="name"
                required
                minlength="2"
                maxlength="120"
                autocomplete="name"
                enterkeyhint="next"
                placeholder={c.namePlaceholder}
                aria-errormessage={`${idPrefix}-name-err`}
                class="k-input"
              />
              <div id={`${idPrefix}-name-err`} class="k-error-msg">
                <Icon name="alert" class="h-4 w-4 shrink-0" />
                <span>{c.nameError}</span>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for={`${idPrefix}-phone`} class="mb-1.5 block text-sm font-semibold text-[var(--text-primary)]">
                  {c.phoneLabel}
                </label>
                <input
                  type="tel"
                  id={`${idPrefix}-phone`}
                  name="phone"
                  autocomplete="tel"
                  inputmode="tel"
                  enterkeyhint="next"
                  pattern={'[0-9+\\(\\)\\-\\s]{7,22}'}
                  placeholder={c.phonePlaceholder}
                  aria-errormessage={`${idPrefix}-phone-err`}
                  class="k-input"
                />
                <div id={`${idPrefix}-phone-err`} class="k-error-msg">
                  <Icon name="alert" class="h-4 w-4 shrink-0" />
                  <span>{c.phoneError}</span>
                </div>
              </div>

              <div>
                <label for={`${idPrefix}-email`} class="mb-1.5 block text-sm font-semibold text-[var(--text-primary)]">
                  {c.emailLabel} <span class="text-[var(--status-error)]" aria-hidden="true">*</span>
                </label>
                <input
                  type="email"
                  id={`${idPrefix}-email`}
                  name="email"
                  required
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  spellcheck="false"
                  enterkeyhint="next"
                  placeholder={c.emailPlaceholder}
                  aria-errormessage={`${idPrefix}-email-err`}
                  class="k-input"
                />
                <div id={`${idPrefix}-email-err`} class="k-error-msg">
                  <Icon name="alert" class="h-4 w-4 shrink-0" />
                  <span>{c.emailError}</span>
                </div>
              </div>
            </div>

            <div>
              <label for={`${idPrefix}-message`} class="mb-1.5 block text-sm font-semibold text-[var(--text-primary)]">
                {c.messageLabel} <span class="text-[var(--status-error)]" aria-hidden="true">*</span>
              </label>
              <textarea
                id={`${idPrefix}-message`}
                name="message"
                rows="4"
                required
                minlength="5"
                maxlength="2000"
                placeholder={c.messagePlaceholder}
                aria-errormessage={`${idPrefix}-message-err`}
                class="k-input resize-y"
              ></textarea>
              <div id={`${idPrefix}-message-err`} class="k-error-msg">
                <Icon name="alert" class="h-4 w-4 shrink-0" />
                <span>{c.messageError}</span>
              </div>
            </div>

            <div class="flex flex-col items-start justify-between gap-4 pt-1 sm:flex-row sm:items-center">
              <button type="submit" class="k-btn-primary w-full sm:w-auto">
                <span data-submit-label>{c.submitLabel}</span>
                <Icon name="arrow-right" class="h-4 w-4" />
              </button>
            </div>

            <div
              data-form-feedback
              aria-live="polite"
              class="hidden rounded border border-[var(--status-success)] bg-[var(--status-success-bg)] px-4 py-3 text-sm font-medium text-[var(--status-success)]"
            ></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
