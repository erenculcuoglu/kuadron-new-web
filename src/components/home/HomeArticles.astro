---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import type { Locale } from '../../data/types';

interface Props { lang: Locale }
const { lang } = Astro.props;
const posts = lang === 'tr'
  ? (await getCollection('blog')).sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate)).slice(0, 3)
  : [];
---

{posts.length > 0 && (
  <section class="editorial-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Kuadron Blog" title="Son Blog Yazılarımız" href="/blog/" linkLabel="Tüm Yazıları Oku" />
      <div class="article-grid">
        {posts.map((post) => (
          <article class="editorial-story">
            <img src={post.data.coverImage} alt="" width="480" height="300" loading="lazy" class="story-image" />
            <p class="story-meta"><time datetime={post.data.pubDate}>{post.data.displayDate}</time><span>{post.data.readingTime} dk okuma</span></p>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            <p class="section-description">{post.data.description}</p>
            <a href={`/blog/${post.id}/`} class="editorial-link">Yazıyı Oku<Icon name="arrow-right" class="h-4 w-4" /></a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
