---
import Icon from '../Icon.astro';
import { SITE_CONTENT } from '../../data/site-content';
import type { Locale } from '../../data/types';

interface Props { lang: Locale }
const { lang } = Astro.props;
const { home, nav } = SITE_CONTENT[lang];

const groupSpecs = [
  {
    title: lang === 'tr' ? 'Kurumsal İş Sistemleri' : 'Enterprise Business Systems',
    icons: ['layers', 'users', 'network', 'briefcase'],
  },
  {
    title: lang === 'tr' ? 'Özel Mühendislik & Bulut' : 'Custom Engineering & Cloud',
    icons: ['code', 'smartphone', 'cloud', 'rocket'],
  },
  {
    title: lang === 'tr' ? 'Strateji, Kalite & Dönüşüm' : 'Strategy, Quality & Transformation',
    icons: ['compass', 'award', 'building'],
  },
];

const used = new Set<(typeof home.serviceList)[number]>();
const capabilityGroups = groupSpecs.map((group) => ({
  title: group.title,
  items: group.icons.flatMap((icon) =>
    home.serviceList.filter((item) => {
      if (item.icon === icon && !used.has(item)) {
        used.add(item);
        return true;
      }
      return false;
    }),
  ),
}));

const remaining = home.serviceList.filter((item) => !used.has(item));
if (remaining.length > 0) {
  capabilityGroups[capabilityGroups.length - 1].items.push(...remaining);
}
---

<section id="cozumler" class="home-services py-16 sm:py-24" aria-labelledby="services-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="services-layout">
      <div>
        <p class="section-label">{home.servicesEyebrow}</p>
        <h2 id="services-title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{home.servicesTitle}</h2>
        <p class="mt-5 max-w-md leading-relaxed text-[var(--text-secondary)]">{home.servicesDescription}</p>
      </div>
      <div class="service-list">
        {nav.servicesItems.map((service, index) => (
          <a href={service.href} class="service-row">
            <span class="service-number" aria-hidden="true">0{index + 1}</span>
            <span><h3>{service.label}</h3><p>{service.desc}</p></span>
            <Icon name="arrow-right" class="h-5 w-5 shrink-0" />
          </a>
        ))}
      </div>
    </div>

    <div
      class="capability-groups"
      role="region"
      aria-label={lang === 'tr' ? 'Çalışma alanlarımız' : 'Our capabilities'}
    >
      {capabilityGroups.map((group) => (
        <div class="capability-group">
          <div class="capability-group-head">
            <h3 class="capability-group-title">{group.title}</h3>
          </div>
          <ul class="capability-items">
            {group.items.map((service) => (
              <li class="capability-item">
                <Icon name={service.icon} class="capability-icon" />
                <div class="capability-copy">
                  <span class="capability-category">{service.category}</span>
                  <strong class="capability-title">{service.title}</strong>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
