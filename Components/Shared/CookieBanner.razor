@inject SiteDataService SiteData
@inject IConfiguration Configuration
@{
    var banner = SiteData.GetLocale(Lang).CookieBanner;
    var gaId = Configuration["PUBLIC_GA_ID"] ?? "";
}

<aside id="kuadron-cookie-banner" data-analytics-id="@gaId" aria-label="@(Lang == "tr" ? "Çerez bildirimi" : "Cookie notice")" class="fixed inset-x-4 bottom-4 z-40 mx-auto hidden max-w-3xl rounded-2xl border border-[var(--border-strong)] bg-[var(--bg-elevated)] p-4 shadow-2xl sm:px-6">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
        <p class="text-xs leading-relaxed text-[var(--text-secondary)] sm:text-sm">
            @banner.Text
            <a href="@banner.LinkHref" class="font-semibold text-[var(--brand-sky)] underline underline-offset-2">
                @banner.LinkLabel
            </a>
        </p>
        <div class="flex shrink-0 flex-wrap gap-2">
            <button type="button" data-cookie-reject class="k-btn-secondary !min-h-10 !px-4 !text-xs">
                @(Lang == "tr" ? "İzlemeyi reddet" : "Reject analytics")
            </button>
            <button type="button" data-cookie-accept class="k-btn-amber !min-h-10 shrink-0 !px-5 !py-2 !text-xs">
                @banner.AcceptLabel
            </button>
        </div>
    </div>
</aside>

@code {
    [Parameter] public string Lang { get; set; } = "tr";
}

