<figure class="ozbi-agent-showcase" aria-label="@FigureLabel" data-ozbi-console>
    <div class="ozbi-scenario-tabs" role="tablist" aria-label="@TablistLabel">
        @for (int idx = 0; idx < Scenarios.Length; idx++)
        {
            var scenario = Scenarios[idx];
            var isFirst = idx == 0;
            <button type="button"
                    role="tab"
                    id="@($"ozbi-tab-{Lang}-{scenario.Id}")"
                    aria-selected="@(isFirst ? "true" : "false")"
                    aria-controls="@($"ozbi-panel-{Lang}-{scenario.Id}")"
                    tabindex="@(isFirst ? 0 : -1)"
                    class="@($"ozbi-scenario-tab{(isFirst ? " is-active" : "")}")"
                    data-ozbi-tab="@scenario.Id">
                <span class="ozbi-tab-dot" aria-hidden="true"></span>
                <span>@scenario.Num @scenario.Tab</span>
            </button>
        }
    </div>

    @for (int idx = 0; idx < Scenarios.Length; idx++)
    {
        var scenario = Scenarios[idx];
        var isFirst = idx == 0;
        <div role="tabpanel"
             id="@($"ozbi-panel-{Lang}-{scenario.Id}")"
             aria-labelledby="@($"ozbi-tab-{Lang}-{scenario.Id}")"
             hidden="@(!isFirst)"
             class="ozbi-console-card"
             data-ozbi-panel="@scenario.Id">
            <div class="ozbi-agent-bar">
                <span class="ozbi-agent-pill">@scenario.Agent</span>
                <span class="ozbi-agent-meta">@scenario.Assistant</span>
            </div>

            <div class="ozbi-query-box">
                <p class="ozbi-query-label">
                    <span class="ozbi-query-dot" aria-hidden="true"></span>
                    @UserQueryLabel
                </p>
                <p class="ozbi-query-text">@scenario.Question</p>
            </div>

            <div class="ozbi-report-box">
                <div class="ozbi-report-header">
                    <div class="ozbi-report-header-left">
                        <span class="ozbi-report-eyebrow">@AiResponseLabel</span>
                        <span class="ozbi-model-chip">@ModelBadge</span>
                    </div>
                    <span class="ozbi-sql-badge">@scenario.SqlBadge</span>
                </div>

                <h4 class="ozbi-report-title">@scenario.ReportTitle</h4>
                <p class="ozbi-summary-tag">@scenario.SummaryTag</p>

                <ul class="ozbi-report-bullets" role="list">
                    @foreach (var bullet in scenario.Bullets)
                    {
                        <li>
                            <strong class="ozbi-bullet-lead">@bullet.Lead</strong>
                            <span>@((MarkupString)bullet.Body)</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</figure>

