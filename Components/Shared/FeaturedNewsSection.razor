@inject SiteDataService SiteData

<section class="editorial-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeading Eyebrow="@News.Eyebrow" Title="@News.Title" Href="@News.ViewAllHref" LinkLabel="@News.ViewAllLabel" />
        <div class="press-grid">
            @foreach (var card in News.Cards)
            {
                <article class="editorial-story">
                    <img src="@($"{card.Image}?v=20261102")" alt="@card.Source" width="420" height="260" decoding="async" class="story-image" />
                    <p class="section-label">@card.Source</p>
                    <h3><a href="@card.Url" target="_blank" rel="noopener noreferrer nofollow">@card.Title</a></h3>
                    <p class="section-description">@card.Excerpt</p>
                    <a href="@card.Url" target="_blank" rel="noopener noreferrer nofollow" class="editorial-link">
                        @card.CtaLabel<Icon Name="external" Class="h-4 w-4" />
                    </a>
                </article>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public string Lang { get; set; } = "tr";

    private FeaturedNewsSectionContent News => SiteData.GetLocale(Lang).FeaturedNewsSection;
}

