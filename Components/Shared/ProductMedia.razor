<div class="@VisualClass">
    @if (Product.Visual == "ozbi-flow")
    {
        <OzbiFlow Lang="@Lang" />
    }
    else if (Product.Visual == "klinitra-suite")
    {
        <KlinitraPreview Lang="@Lang" />
    }
    else if (Product.Visual == "strife-suite")
    {
        <StrifePreview Lang="@Lang" />
    }
    else
    {
        <img src="@Product.Image"
             alt="@($"{Product.Name} — {Product.Tagline}")"
             width="@(Product.ImageWidth ?? 640)"
             height="@(Product.ImageHeight ?? 360)"
             decoding="async" />
    }
</div>

@code {
    [Parameter, EditorRequired] public ProductItem Product { get; set; } = default!;
    [Parameter] public string Lang { get; set; } = "tr";

    private string VisualClass => Product.Visual switch
    {
        "ozbi-flow" => "product-visual product-visual-ozbi",
        "klinitra-suite" => "product-visual product-visual-klinitra",
        "strife-suite" => "product-visual product-visual-strife",
        _ => "product-visual"
    };
}

