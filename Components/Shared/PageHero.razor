<section class="page-hero border-b border-[var(--border-subtle)] py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-5">
            <ol class="flex items-center gap-2 text-xs font-medium text-[var(--text-muted)]">
                <li>
                    <a href="@(Lang == "tr" ? "/" : "/en/")" class="transition-colors hover:text-[var(--text-primary)]">
                        @(Lang == "tr" ? "Ana Sayfa" : "Home")
                    </a>
                </li>
                <li aria-hidden="true">/</li>
                <li class="text-[var(--text-primary)] font-semibold" aria-current="page">@Title</li>
            </ol>
        </nav>

        <div class="inline-flex items-center gap-2 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3.5 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-[var(--brand-amber-text)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#FBB040]"></span>
            <span>@Eyebrow</span>
        </div>

        <h1 class="mt-4 max-w-3xl text-3xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl">
            @Title
        </h1>

        @if (!string.IsNullOrWhiteSpace(Lead))
        {
            <p class="mt-5 max-w-3xl text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
                @Lead
            </p>
        }

        @if (Steps is { Count: > 0 })
        {
            <div class="mt-10 border-t border-[var(--border-subtle)] pt-8 sm:mt-12 sm:pt-10">
                <ol class="workflow-list" style="margin-top:0" role="list">
                    @for (var i = 0; i < Steps.Count; i++)
                    {
                        var step = Steps[i];
                        <li class="workflow-step">
                            <div class="workflow-node">
                                <span class="workflow-number">@step.Number</span>
                                @if (i < Steps.Count - 1)
                                {
                                    <Icon Name="arrow-right" Class="workflow-arrow h-5 w-5" />
                                }
                            </div>
                            <h3>@step.Title</h3>
                            <p>@step.Description</p>
                        </li>
                    }
                </ol>
            </div>
        }
    </div>
</section>

@code {
    [Parameter] public string Lang { get; set; } = "tr";
    [Parameter, EditorRequired] public string Eyebrow { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Lead { get; set; }
    [Parameter] public IReadOnlyList<WorkflowStep>? Steps { get; set; }
}

