<figure class="rql-suite-card" aria-label="@FigureLabel" data-rql-console>
    <!-- Clean Top App Bar -->
    <div class="rql-topbar">
        <div class="rql-topbar-left">
            <span class="rql-brand-logo" aria-hidden="true">rql</span>
            <span class="rql-conn-pill">
                <span class="rql-conn-dot" aria-hidden="true"></span>
                <span>@(Lang == "tr" ? "Bağlantı: Sample Northwind (SQL)" : "Connection: Sample Northwind (SQL)")</span>
            </span>
        </div>
        <div class="rql-topbar-right">
            <span class="rql-btn-green">⊕ @(Lang == "tr" ? "Yeni Ekle" : "Add New")</span>
            <span class="rql-btn-save">✓ @(Lang == "tr" ? "Kaydet" : "Save")</span>
        </div>
    </div>

    <!-- 3 Spacious Interactive Mode Tabs: Table / Pivot / Dashboard & Chart -->
    <div class="rql-tabs" role="tablist" aria-label="@(Lang == "tr" ? "Reportql Rapor Formatları" : "Reportql Output Formats")">
        <button type="button"
                role="tab"
                aria-selected="true"
                class="rql-tab is-active"
                data-rql-format-btn="dashboard"
                data-format-sql="@DashboardSql"
                data-format-badge="@(Lang == "tr" ? "Çıktı: KPI Kartları + Grafik Pano" : "Output: KPI Widgets + Chart Dashboard")">
            <span class="rql-tab-code">01</span>
            <span>@(Lang == "tr" ? "Pano (Dashboard) & Grafik" : "Dashboard & Chart")</span>
        </button>
        <button type="button"
                role="tab"
                aria-selected="false"
                class="rql-tab"
                data-rql-format-btn="pivot"
                data-format-sql="@PivotSql"
                data-format-badge="@(Lang == "tr" ? "Çıktı: Çapraz Pivot Matris (Satır × Sütun)" : "Output: Cross-Tab Pivot Matrix")">
            <span class="rql-tab-code">02</span>
            <span>@(Lang == "tr" ? "Pivot Tablo" : "Pivot Matrix")</span>
        </button>
        <button type="button"
                role="tab"
                aria-selected="false"
                class="rql-tab"
                data-rql-format-btn="table"
                data-format-sql="@TableSql"
                data-format-badge="@(Lang == "tr" ? "Çıktı: Dinamik Veri Tablosu" : "Output: Dynamic Data Table")">
            <span class="rql-tab-code">03</span>
            <span>@(Lang == "tr" ? "Tablo Rapor" : "Table Report")</span>
        </button>
    </div>

    <div class="rql-body">
        <!-- STEP 1: Compact Low-Code SQL Input Box -->
        <div class="rql-sql-box">
            <div class="rql-sql-header">
                <div class="rql-sql-title">
                    <span class="rql-step-badge">@(Lang == "tr" ? "1. ADIM · KENDİ SQL SORGUNUZ" : "STEP 1 · YOUR SQL QUERY")</span>
                </div>
                <span class="rql-run-pill">
                    @(Lang == "tr" ? "⚡ Rapor Üret" : "⚡ Generate Report")
                </span>
            </div>
            <pre class="rql-sql-code"><code data-rql-sql-code>@DashboardSql</code></pre>
        </div>

        <!-- STEP 2: Rendered Output Container -->
        <div class="rql-output-box">
            <div class="rql-output-header">
                <span class="rql-step-badge is-output">@(Lang == "tr" ? "2. ADIM · HAZIR RAPOR & PANO ÇIKTISI" : "STEP 2 · GENERATED REPORT & DASHBOARD")</span>
                <span class="rql-output-meta" data-rql-active-label>
                    @(Lang == "tr" ? "Çıktı: KPI Kartları + Grafik Pano" : "Output: KPI Widgets + Chart Dashboard")
                </span>
            </div>

            <!-- VIEW 1: DASHBOARD & CHART (Default) -->
            <div class="rql-view" data-rql-format-view="dashboard">
                <div class="rql-kpi-grid">
                    @foreach (var kpi in KpiSummary)
                    {
                        <div class="rql-kpi-card">
                            <div class="rql-kpi-card-top">
                                <span>@kpi.Title</span>
                                <span class="rql-edit-dot" aria-hidden="true">✎</span>
                            </div>
                            <strong>@kpi.Value</strong>
                            <small>@kpi.Sub</small>
                        </div>
                    }
                </div>

                <div class="rql-chart-card">
                    <div class="rql-chart-head">
                        <strong>@(Lang == "tr" ? "Product Sales — Kategori Bazlı Satış Grafiği" : "Product Sales — Sales by Category")</strong>
                        <span>Northwind DB</span>
                    </div>
                    <div class="rql-chart-bars">
                        @foreach (var row in SalesRows)
                        {
                            <div class="rql-chart-row">
                                <div class="rql-chart-label">
                                    <strong>@row.Category</strong>
                                    <span>@row.Revenue (@row.Share)</span>
                                </div>
                                <div class="rql-chart-track">
                                    <div class="rql-chart-fill" style="width:@row.BarWidth;background:@row.Color"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- VIEW 2: PIVOT MATRIX -->
            <div class="rql-view" data-rql-format-view="pivot" hidden>
                <div class="rql-table-scroll" tabindex="0" role="region" aria-label="Pivot Matrix">
                    <table class="rql-data-table rql-pivot-table">
                        <thead>
                            <tr>
                                <th scope="col">@(Lang == "tr" ? "Kategori \\ Dönem" : "Category \\ Quarter")</th>
                                <th scope="col">Q1</th>
                                <th scope="col">Q2</th>
                                <th scope="col">Q3</th>
                                <th scope="col">Q4</th>
                                <th scope="col" class="rql-pivot-total-col">@(Lang == "tr" ? "Toplam" : "Total")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in PivotRows)
                            {
                                <tr>
                                    <th scope="row">@p.Category</th>
                                    <td>@p.Q1</td>
                                    <td>@p.Q2</td>
                                    <td>@p.Q3</td>
                                    <td>@p.Q4</td>
                                    <td class="rql-pivot-total-col">@p.Total</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th scope="row">@(Lang == "tr" ? "Genel Toplam" : "Grand Total")</th>
                                <td>$172.8K</td>
                                <td>$201.3K</td>
                                <td>$216.0K</td>
                                <td>$242.6K</td>
                                <td class="rql-pivot-total-col">$832.7K</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- VIEW 3: TABLE REPORT -->
            <div class="rql-view" data-rql-format-view="table" hidden>
                <div class="rql-table-scroll" tabindex="0" role="region" aria-label="SQL Table Report">
                    <table class="rql-data-table">
                        <thead>
                            <tr>
                                <th scope="col">@(Lang == "tr" ? "Kategori" : "Category")</th>
                                <th scope="col">@(Lang == "tr" ? "En Çok Satan Ürün" : "Top Product")</th>
                                <th scope="col">@(Lang == "tr" ? "Sipariş" : "Orders")</th>
                                <th scope="col">@(Lang == "tr" ? "Toplam Ciro" : "Total Sales")</th>
                                <th scope="col">@(Lang == "tr" ? "Pay" : "Share")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in SalesRows)
                            {
                                <tr>
                                    <th scope="row">@row.Category</th>
                                    <td>@row.Product</td>
                                    <td>@row.OrderCount</td>
                                    <td class="rql-num-strong">@row.Revenue</td>
                                    <td><span class="rql-share-pill">@row.Share</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</figure>

@code {
    [Parameter] public string Lang { get; set; } = "tr";

    private sealed record KpiItem(string Title, string Value, string Sub);
    private sealed record SalesRowItem(string Category, string Product, int OrderCount, string Revenue, string Share, string BarWidth, string Color);
    private sealed record PivotRowItem(string Category, string Q1, string Q2, string Q3, string Q4, string Total);

    private string FigureLabel => Lang == "tr"
        ? "Reportql low-code SQL raporlama, pivot tablo ve pano tasarlayıcı (dashboard) önizlemesi"
        : "Reportql low-code SQL reporting, pivot matrix, and dashboard designer preview";

    private const string DashboardSql =
        "SELECT c.CategoryName, SUM(od.Quantity * od.UnitPrice) AS TotalSales\nFROM Categories c JOIN Products p ON c.CategoryID = p.CategoryID\nJOIN [OrderDetails] od ON p.ProductID = od.ProductID\nGROUP BY c.CategoryName ORDER BY TotalSales DESC;";

    private const string PivotSql =
        "SELECT c.CategoryName, STRFTIME('%Y-Q', o.OrderDate) AS Quarter, SUM(od.Quantity * od.UnitPrice) AS Revenue\nFROM Categories c JOIN Products p ON c.CategoryID = p.CategoryID\nJOIN [OrderDetails] od ON p.ProductID = od.ProductID JOIN Orders o ON o.OrderID = od.OrderID\nGROUP BY c.CategoryName, Quarter; -- Reportql Pivot: Satır=CategoryName, Sütun=Quarter";

    private const string TableSql =
        "SELECT c.CategoryName, COUNT(DISTINCT o.OrderID) AS Orders, SUM(od.Quantity * od.UnitPrice) AS TotalSales\nFROM Categories c JOIN Products p ON c.CategoryID = p.CategoryID\nJOIN [OrderDetails] od ON p.ProductID = od.ProductID JOIN Orders o ON o.OrderID = od.OrderID\nGROUP BY c.CategoryName ORDER BY TotalSales DESC;";

    private static readonly KpiItem[] KpiSummary =
    [
        new("Employee With Most Sales", "Margaret Peacock", "$250,187 · 156 Sipariş"),
        new("Turnover (Toplam Ciro)", "$1,354,458", "+18.4% Yıllık Büyüme"),
        new("Top Sales Country", "USA ($263.5K)", "122 Sipariş · 13 Müşteri")
    ];

    private static readonly SalesRowItem[] SalesRows =
    [
        new("Beverages", "Côte de Blaye", 404, "$267,868", "32.2%", "100%", "#0284c7"),
        new("Dairy Products", "Raclette Courdavault", 366, "$234,507", "28.1%", "88%", "#10b981"),
        new("Confections", "Sir Rodney's Marmalade", 334, "$167,357", "20.1%", "63%", "#8b5cf6"),
        new("Meat / Poultry", "Thüringer Rostbratwurst", 173, "$163,022", "19.6%", "61%", "#f59e0b")
    ];

    private static readonly PivotRowItem[] PivotRows =
    [
        new("Beverages", "$54.1K", "$63.5K", "$71.2K", "$79.1K", "$267.9K"),
        new("Dairy Products", "$48.9K", "$58.1K", "$60.3K", "$67.2K", "$234.5K"),
        new("Confections", "$36.2K", "$41.8K", "$42.9K", "$46.4K", "$167.3K"),
        new("Meat / Poultry", "$33.6K", "$37.9K", "$41.6K", "$49.9K", "$163.0K")
    ];
}
