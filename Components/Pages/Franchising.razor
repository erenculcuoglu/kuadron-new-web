@page "/bayilik"
@page "/en/franchising"
@using System.Text.Json
@inject SiteDataService SiteData
@inject NavigationManager Navigation

<PageMeta Title="@F.MetaTitle" Description="@F.MetaDescription" JsonLd="@FaqJsonLd" />

<PageHero Lang="@Lang"
          Eyebrow="@F.Eyebrow"
          Title="@F.Title"
          Lead="@(Lang == "tr"
              ? "Kuadron’un lokomotif yapay zeka ürünleri OzBI ve Klinitra için yetkili satış ve çözüm ortağı olun."
              : "Become an authorized sales and solution partner for Kuadron’s flagship AI platforms OzBI and Klinitra.")" />

<!-- Intro & Native <details name="franchise-faq"> Searchable Accordion -->
<section class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-5">
                <h2 class="text-2xl font-extrabold leading-tight text-[var(--text-primary)] sm:text-4xl">
                    @F.IntroTitle
                </h2>
                <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
                    @F.IntroDescription
                </p>

                <div class="mt-8 flex flex-wrap gap-3">
                    <button type="button"
                            data-open-dialog="franchise-apply-dialog"
                            class="k-btn-amber">
                        <span>@F.CtaButtonLabel</span>
                        <Icon Name="arrow-right" Class="h-4 w-4" />
                    </button>
                    <a href="https://www.ozbiapp.com.tr/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="k-btn-secondary">
                        <span>OzBI</span>
                        <Icon Name="external" Class="h-4 w-4" />
                    </a>
                    <a href="https://www.klinitra.com/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="k-btn-secondary">
                        <span>Klinitra</span>
                        <Icon Name="external" Class="h-4 w-4" />
                    </a>
                </div>
            </div>

            <!-- Exclusive <details> group -->
            <div class="space-y-4 lg:col-span-7">
                @for (int idx = 0; idx < F.Faqs.Count; idx++)
                {
                    var faq = F.Faqs[idx];
                    <details name="franchise-faq"
                             open="@(idx == 0)"
                             class="k-accordion k-card overflow-hidden">
                        <summary class="flex items-center justify-between gap-4 p-5 text-base font-bold text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] sm:p-6">
                            <span>@faq.Question</span>
                            <span class="accordion-chevron inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[var(--brand-amber-bg)] text-[var(--brand-amber-text)] transition-transform duration-200">
                                <Icon Name="plus" Class="h-4 w-4" />
                            </span>
                        </summary>
                        <div class="border-t border-[var(--border-subtle)] px-5 py-4 text-sm leading-relaxed text-[var(--text-secondary)] sm:px-6 sm:py-5 sm:text-base">
                            @faq.Answer
                        </div>
                    </details>
                }
            </div>
        </div>
    </div>
</section>

<!-- 6 Partner Advantages Grid -->
<section class="border-y border-[var(--border-subtle)] bg-[var(--bg-subtle)] py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-center text-2xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl">
            @F.BenefitsTitle
        </h2>

        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @for (int idx = 0; idx < F.Benefits.Count; idx++)
            {
                var b = F.Benefits[idx];
                <article class="@($"k-card k-card-hover p-6 sm:p-7{(idx == 0 ? " border-[var(--brand-amber)]" : "")}")">
                    <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--brand-amber-bg)] text-[var(--brand-amber-text)]">
                        <Icon Name="@b.Icon" Class="h-6 w-6" />
                    </span>
                    <h3 class="mt-5 text-lg font-bold text-[var(--text-primary)]">@b.Title</h3>
                    <p class="mt-2.5 text-sm leading-relaxed text-[var(--text-secondary)]">@b.Description</p>
                </article>
            }
        </div>
    </div>
</section>

<!-- Split Partner Application Banner -->
<section class="py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="overflow-hidden rounded-3xl border border-[#1e2f4a] bg-[#0b1424] text-white shadow-xl">
            <div class="grid grid-cols-1 items-center lg:grid-cols-12">
                <div class="lg:col-span-5">
                    <img src="@F.BannerImage"
                         alt="@F.CtaBannerTitle"
                         decoding="async"
                         width="600"
                         height="420"
                         class="h-64 w-full object-cover lg:h-full lg:min-h-[22rem]" />
                </div>
                <div class="p-8 sm:p-12 lg:col-span-7">
                    <h2 class="text-2xl font-extrabold text-white sm:text-4xl">@F.CtaBannerTitle</h2>
                    <p class="mt-3 max-w-xl text-base leading-relaxed text-slate-300">@F.CtaBannerSubtitle</p>
                    <div class="mt-7 flex flex-wrap items-center gap-4">
                        <button type="button"
                                data-open-dialog="franchise-apply-dialog"
                                class="k-btn-amber">
                            <span>@F.CtaButtonLabel</span>
                            <Icon Name="arrow-right" Class="h-4 w-4" />
                        </button>
                        <a href="@($"mailto:{Company.ChannelEmail}")"
                           class="inline-flex items-center gap-2 text-sm font-semibold text-amber-300 hover:underline">
                            <Icon Name="mail" Class="h-4 w-4" />
                            <span>@Company.ChannelEmail</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<FeaturedNewsSection Lang="@Lang" />
<ContactSection Lang="@Lang" />

<ApplicationModal DialogId="franchise-apply-dialog"
                  Lang="@Lang"
                  Title="@F.CtaButtonLabel"
                  Subtitle="@F.IntroDescription"
                  FallbackEmail="@Company.ChannelEmail"
                  JotformUrl="@Company.Jotform.Franchise"
                  ExtraFieldLabel="@(Lang == "tr" ? "Firma Adı, Şehir ve Ürün (OzBI / Klinitra)" : "Company Name, City & Product (OzBI / Klinitra)")"
                  ExtraFieldName="company_city"
                  ExtraFieldPlaceholder="@(Lang == "tr" ? "Örn: ABC Teknoloji - İstanbul (OzBI / Klinitra)" : "e.g. ABC Tech - Istanbul (OzBI / Klinitra)")" />

@code {
    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;
    private string Lang => SiteData.DetectLocale(CurrentPath);
    private FranchisingContent F => SiteData.GetLocale(Lang).Franchising;
    private CompanyInfoModel Company => SiteData.Company;

    private string FaqJsonLd => JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = F.Faqs.Select(item => new Dictionary<string, object>
        {
            ["@type"] = "Question",
            ["name"] = item.Question,
            ["acceptedAnswer"] = new Dictionary<string, object>
            {
                ["@type"] = "Answer",
                ["text"] = item.Answer
            }
        }).ToArray()
    });
}

