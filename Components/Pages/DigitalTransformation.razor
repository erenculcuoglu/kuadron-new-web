@page "/dijital-donusum-ve-yz-danismanligi"
@page "/en/digital-transformation-and-ai-consultancy"
@inject SiteDataService SiteData
@inject NavigationManager Navigation

<PageMeta Title="@D.MetaTitle" Description="@D.MetaDescription" />

<PageHero Lang="@Lang" Eyebrow="@D.Eyebrow" Title="@D.Title" Lead="@D.Lead" />

<!-- 1. Görsel & İnteraktif Kurumsal Dönüşüm Stüdyosu (Öncesi / Sonrası Simülatörü) -->
<section class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-12">
            <!-- Sol: Görsel Kompozisyon & Mimari Kazanım Telemetrisi -->
            <div class="lg:col-span-5">
                <div class="dt-studio-visual shadow-xl">
                    <img src="/uploads/site/kuadron-ekip-ruhu.jpg"
                         alt="@(IsTr ? "Kuadron OSTİM Teknopark Dijital Dönüşüm ve YZ Mühendislik Ekibi" : "Kuadron Digital Transformation and AI Engineering Team")"
                         width="680"
                         height="425"
                         decoding="async"
                         class="dt-studio-photo" />
                    <div class="p-5 sm:p-6">
                        <p class="font-mono text-xs font-semibold uppercase tracking-wider text-[#FBB040]">
                            @(IsTr ? "OSTİM TEKNOPARK AR-GE & DANIŞMANLIK ETKİSİ" : "OSTIM TECHNOPARK R&D & CONSULTANCY IMPACT")
                        </p>
                        <h2 class="mt-2 text-lg font-bold text-white sm:text-xl">
                            @(IsTr
                                ? "Mevcut ERP ve Veri Altyapınızı Bozmadan Yapay Zeka Katmanı Ekliyoruz"
                                : "Adding an Enterprise AI Layer Without Disrupting Your Existing ERP Stack")
                        </h2>
                        <div class="dt-kpi-grid mt-4">
                            @foreach (var kpi in StudioKpis)
                            {
                                <div class="dt-kpi-item">
                                    <strong>@kpi.Value</strong>
                                    <span>@kpi.Label</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sağ: İnteraktif Departman Dönüşüm Simülatörü (Öncesi vs. Sonrası) -->
            <div class="lg:col-span-7" data-ai-studio>
                <p class="section-label">
                    <span></span>@(IsTr ? "İnteraktif Dönüşüm Simülatörü" : "Interactive Transformation Simulator")
                </p>
                <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl">
                    @(IsTr
                        ? "Departmanlarda Geleneksel Süreçten YZ Mimarisine Geçiş"
                        : "From Legacy Departmental Workflows to Autonomous AI")
                </h2>
                <p class="mt-3 text-base leading-relaxed text-[var(--text-secondary)]">
                    @(IsTr
                        ? "Bir departman seçerek geleneksel işleyiş ile Kuadron’un kurguladığı yapay zeka & Agent mimarisi arasındaki farkı inceleyin:"
                        : "Select a department below to compare legacy manual processes against Kuadron’s AI & Agent architecture:")
                </p>

                <div class="dt-studio-tabs mt-6" role="tablist" aria-label="@(IsTr ? "Dönüşüm departmanları" : "Transformation departments")">
                    @for (int i = 0; i < UseCases.Length; i++)
                    {
                        var uc = UseCases[i];
                        var isFirst = i == 0;
                        <button type="button"
                                role="tab"
                                id="@($"dt-tab-{Lang}-{uc.Id}")"
                                aria-selected="@(isFirst ? "true" : "false")"
                                aria-controls="@($"dt-panel-{Lang}-{uc.Id}")"
                                tabindex="@(isFirst ? 0 : -1)"
                                class="@($"dt-studio-tab{(isFirst ? " is-active" : "")}")">
                            <Icon Name="@uc.Icon" Class="h-4 w-4" />
                            <span>@uc.TabLabel</span>
                        </button>
                    }
                </div>

                @for (int i = 0; i < UseCases.Length; i++)
                {
                    var uc = UseCases[i];
                    var isFirst = i == 0;
                    <div role="tabpanel"
                         id="@($"dt-panel-{Lang}-{uc.Id}")"
                         aria-labelledby="@($"dt-tab-{Lang}-{uc.Id}")"
                         hidden="@(!isFirst)"
                         class="k-card p-6 sm:p-7">
                        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-subtle)] pb-4">
                            <div>
                                <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--brand-amber-text)]">
                                    @uc.Badge
                                </span>
                                <h3 class="mt-1 text-xl font-bold text-[var(--text-primary)]">@uc.Title</h3>
                            </div>
                            <span class="rounded-full bg-[var(--status-success-bg)] px-3 py-1 font-mono text-xs font-bold text-[var(--status-success)]">
                                @uc.ImpactMetric
                            </span>
                        </div>

                        <div class="dt-compare-grid">
                            <div class="dt-compare-box dt-compare-before">
                                <span class="dt-compare-tag">@(IsTr ? "Geleneksel Süreç (Öncesi)" : "Legacy Process (Before)")</span>
                                <p class="text-sm leading-relaxed text-[var(--text-secondary)]">@uc.BeforeText</p>
                            </div>
                            <div class="dt-compare-box dt-compare-after">
                                <span class="dt-compare-tag">@(IsTr ? "Kuadron YZ Mimarisi (Sonrası)" : "Kuadron AI Architecture (After)")</span>
                                <p class="text-sm font-medium leading-relaxed text-[var(--text-primary)]">@uc.AfterText</p>
                            </div>
                        </div>

                        <div class="mt-5 flex flex-wrap items-center gap-2 pt-3 border-t border-[var(--border-subtle)]">
                            @foreach (var tag in uc.Deliverables)
                            {
                                <span class="inline-flex items-center gap-1.5 rounded-md bg-[var(--bg-subtle)] px-2.5 py-1 font-mono text-xs font-semibold text-[var(--text-primary)]">
                                    <Icon Name="check" Class="h-3.5 w-3.5 text-[var(--brand-amber-text)]" />
                                    <span>@tag</span>
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- 2. Adım Adım Yol Haritası -->
<WorkflowSteps Title="@D.WorkflowTitle" Subtitle="@D.WorkflowSubtitle" Steps="@D.Steps" />

<!-- 3. Kurumsal YZ Danışmanlığı Uzmanlık Alanları (6 Kart) -->
<section class="editorial-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12">
            <p class="section-label">
                <span></span>@(IsTr ? "Kurumsal Yapay Zeka (YZ) Danışmanlığı" : "Enterprise AI Consultancy")
            </p>
            <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl">
                @(IsTr
                    ? "Verinizi Konuşan ve Karar Alan Yapay Zeka Mimarisine Dönüştürüyoruz"
                    : "Turning Enterprise Data into Conversational & Autonomous AI Systems")
            </h2>
            <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
                @(IsTr
                    ? "Standart sohbet botlarının ötesine geçin. OSTİM Teknopark’taki Ar-Ge ekibimizle, mevcut ERP/SQL altyapınızı bozmadan kurumunuza özel Agent Modu, RAG kurumsal hafıza ve açıklanabilir karar destek sistemleri inşa ediyoruz."
                    : "Go beyond generic chatbots. Our R&D engineering team builds domain-specific Agent Mode analytics, RAG enterprise memory, and explainable decision-support systems on top of your existing ERP/SQL stack.")
            </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
            @foreach (var pillar in AiPillars)
            {
                <article class="k-card k-card-hover flex flex-col justify-between border-t-2 border-t-[var(--brand-amber)] p-6 sm:p-7">
                    <div>
                        <div class="mb-5 flex items-center justify-between gap-3">
                            <span class="inline-flex items-center rounded-full bg-[var(--brand-amber-bg)] px-3 py-1 font-mono text-xs font-semibold text-[var(--brand-amber-text)]">
                                @pillar.Badge
                            </span>
                            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#0b1424] text-[#FBB040]">
                                <Icon Name="@pillar.Icon" Class="h-5 w-5" />
                            </span>
                        </div>

                        <h3 class="mb-3 text-lg font-bold leading-snug text-[var(--text-primary)] sm:text-xl">
                            @pillar.Title
                        </h3>
                        <p class="mb-6 text-sm leading-relaxed text-[var(--text-secondary)]">
                            @pillar.Desc
                        </p>
                    </div>

                    <ul class="space-y-2 border-t border-[var(--border-subtle)] pt-4">
                        @foreach (var metric in pillar.Metrics)
                        {
                            <li class="flex items-center gap-2 text-xs font-semibold text-[var(--text-primary)]">
                                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--brand-amber)]"></span>
                                <span>@metric</span>
                            </li>
                        }
                    </ul>
                </article>
            }
        </div>
    </div>
</section>

<!-- 4. Kuadron 4 Katmanlı YZ Referans Mimarisi & Canlı Ürün Simülasyonları -->
<section class="border-y border-[var(--border-subtle)] bg-[var(--bg-subtle)] py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-5">
                <p class="section-label">
                    <span></span>@(IsTr ? "Kuadron YZ Referans Mimarisi" : "Kuadron AI Reference Architecture")
                </p>
                <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-3xl">
                    @(IsTr
                        ? "4 Katmanlı Güvenli Kurumsal YZ Entegrasyonu"
                        : "4-Layer Secure Enterprise AI Integration")
                </h2>
                <p class="mt-3 mb-6 text-sm leading-relaxed text-[var(--text-secondary)] sm:text-base">
                    @(IsTr
                        ? "Danışmanlık projelerimizde ve lokomotif ürünlerimiz OzBI ile Klinitra’da uyguladığımız mimari; ham veriyi güvenlik katmanlarından geçirerek doğrudan yönetim kurulu seviyesinde karar özetlerine dönüştürür."
                        : "Proven across our consultancy engagements and flagship products OzBI and Klinitra, our 4-layer architecture transforms raw operational data into board-ready executive decisions.")
                </p>

                <div>
                    @for (int i = 0; i < ArchitectureLayers.Length; i++)
                    {
                        var item = ArchitectureLayers[i];
                        <div class="dt-arch-step">
                            <div class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--brand-amber-text)]">
                                @item.Step
                            </div>
                            <div class="mt-1 text-sm font-bold text-[var(--text-primary)]">
                                @item.Title
                            </div>
                            <p class="mt-1 text-xs leading-relaxed text-[var(--text-secondary)]">
                                @item.Detail
                            </p>
                        </div>
                        @if (i < ArchitectureLayers.Length - 1)
                        {
                            <div class="dt-arch-connector" aria-hidden="true"></div>
                        }
                    }
                </div>
            </div>

            <!-- Sağ: Canlı Ürün Simülasyonu Seçici (OzBI Agent Modu & Klinitra Ekosistemi) -->
            <div class="lg:col-span-7" data-ai-studio>
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--brand-amber-text)]">
                            @(IsTr ? "Canlı Mimari Vitrin (Tıklayarak Deneyin)" : "Live Architecture Showcase (Interactive)")
                        </span>
                        <h3 class="mt-1 text-lg font-bold text-[var(--text-primary)] sm:text-xl">
                            @(IsTr
                                ? "Referans Mimarimizin Canlı Ürünlerimizdeki Uygulaması"
                                : "Our Reference Architecture in Action Across Flagship Products")
                        </h3>
                    </div>

                    <div class="dt-studio-tabs !mb-0" role="tablist" aria-label="@(IsTr ? "Canlı ürün demoları" : "Live product demos")">
                        <button type="button"
                                role="tab"
                                id="@($"arch-demo-tab-{Lang}-ozbi")"
                                aria-selected="true"
                                aria-controls="@($"arch-demo-panel-{Lang}-ozbi")"
                                tabindex="0"
                                class="dt-studio-tab is-active">
                            <span>OzBI Agent Modu</span>
                        </button>
                        <button type="button"
                                role="tab"
                                id="@($"arch-demo-tab-{Lang}-klinitra")"
                                aria-selected="false"
                                aria-controls="@($"arch-demo-panel-{Lang}-klinitra")"
                                tabindex="-1"
                                class="dt-studio-tab">
                            <span>Klinitra AI Suite</span>
                        </button>
                    </div>
                </div>

                <div role="tabpanel"
                     id="@($"arch-demo-panel-{Lang}-ozbi")"
                     aria-labelledby="@($"arch-demo-tab-{Lang}-ozbi")"
                     class="product-visual product-visual-ozbi">
                    <OzbiFlow Lang="@Lang" />
                </div>

                <div role="tabpanel"
                     id="@($"arch-demo-panel-{Lang}-klinitra")"
                     aria-labelledby="@($"arch-demo-tab-{Lang}-klinitra")"
                     hidden
                     class="product-visual product-visual-klinitra">
                    <KlinitraPreview Lang="@Lang" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 5. Saha Dijital Dönüşüm Başarı Örnekleri (Görselli Referans Projeler) -->
<section class="editorial-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeading Eyebrow="@(IsTr ? "Saha Uygulamaları" : "Field Implementations")"
                        Title="@(IsTr ? "Kurumsal Dijital Dönüşüm Referanslarımızdan Seçmeler" : "Selected Enterprise Digital Transformation Case Studies")"
                        Description="@(IsTr ? "Kamu kurumları, enerji dağıtım şirketleri ve Türkiye çapında bayi ağına sahip kuruluşlarda uçtan uca dijitalleştirdiğimiz kritik operasyonlar." : "Mission-critical operations digitized end-to-end across public institutions, energy utilities, and nationwide dealer networks.")"
                        Href="@(IsTr ? "/yazilim-gelistirme" : "/en/software-development")"
                        LinkLabel="@(IsTr ? "Tüm Projeleri İnceleyin" : "Explore All Projects")" />

        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
            @foreach (var prj in HighlightProjects)
            {
                <article class="editorial-story">
                    <img src="@prj.Image"
                         alt="@($"{prj.Client} — {prj.Title}")"
                         width="640"
                         height="400"
                         decoding="async"
                         class="story-image rounded-lg border border-[var(--border-subtle)]" />
                    <p class="section-label"><span></span>@prj.Client</p>
                    <h3>@prj.Title</h3>
                    <p class="section-description">@prj.Description</p>
                    <ul class="story-tags" role="list">
                        @foreach (var f in prj.Features)
                        {
                            <li>@f</li>
                        }
                    </ul>
                </article>
            }
        </div>
    </div>
</section>

<FeaturedNewsSection Lang="@Lang" />
<ContactSection Lang="@Lang" />

@code {
    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;
    private string Lang => SiteData.DetectLocale(CurrentPath);
    private bool IsTr => Lang == "tr";
    private LocaleSiteContent Content => SiteData.GetLocale(Lang);
    private DigitalTransformationContent D => Content.DigitalTransformation;
    private IEnumerable<ProjectItem> HighlightProjects => Content.Projects.Take(3);

    private sealed record KpiItem(string Value, string Label);
    private sealed record UseCaseItem(string Id, string TabLabel, string Icon, string Badge, string Title, string ImpactMetric, string BeforeText, string AfterText, string[] Deliverables);
    private sealed record AiPillarItem(string Badge, string Title, string Desc, string[] Metrics, string Icon);
    private sealed record ArchitectureLayerItem(string Step, string Title, string Detail);

    private KpiItem[] StudioKpis => IsTr
        ? [
            new("4x Hızlı", "Yönetici Karar & Raporlama Süreci"),
            new("< 2.4 sn", "Çapraz SQL & Kök Neden Analizi"),
            new("%100 KVKK", "On-Premise / İzole Bulut LLM"),
            new("7/24 Aktif", "Otonom Anomali & Risk Takibi")
        ]
        : [
            new("4x Faster", "Executive Decision & Reporting Cycle"),
            new("< 2.4 sec", "Cross-SQL & Root-Cause Analysis"),
            new("100% GDPR", "On-Premise / Isolated Cloud LLM"),
            new("24/7 Live", "Autonomous Anomaly & Risk Monitoring")
        ];

    private UseCaseItem[] UseCases => IsTr
        ? [
            new(
                "finans-erp",
                "Finans & ERP",
                "chart",
                "FİNANSAL ANALİTİK & AGENT MODU",
                "Logo, Mikro ve SQL Verisinde Saniyeler İçinde Kök Neden Analizi",
