            new("Healthcare AI", "Clinical, Provider & Insurance Solutions"),
            new("Faster Decisions", "Natural-Language Q&A & Summaries"),
            new("Full Privacy", "Regulation-Compliant Architecture")
        ];

    private UseCaseItem[] UseCases => IsTr
        ? [
            new(
                "is-yazilimlari",
                "İş Yazılımları & Yönetim",
                "chart",
                "KURUMSAL İŞ YAZILIMLARI",
                "Şirket Verilerinizi Konuşan ve Yorumlayan Karar Destek Sistemleri",
                "Saniyeler İçinde Yönetici Özeti",
                "Farklı iş yazılımlarında biriken satış, finans ve stok verilerinin manuel tablolarla birleştirilmesi; raporların hazırlanmasının günler sürmesi.",
                "Mevcut iş yazılımlarınızla doğrudan konuşarak doğal dilde soru sorma, gelir/maliyet eğilimlerini görme ve anlık yönetici özetleri alma imkanı.",
                ["Doğal Dilde Veri Sorgulama", "Gelir ve Maliyet Tahminleme", "Otomatik Yönetici Raporları"]),
            new(
                "saglik-yz",
                "Sağlıkta Yapay Zeka",
                "award",
                "SAĞLIK & KLİNİK UYGULAMALARI",
                "Hekimler, Sağlık Kurumları ve Sigorta Süreçleri İçin Akıllı Asistanlar",
