                ["Clause & Page Citations", "Role-Based Access Control", "Isolated On-Premise Deployment"])
        ];

    private AiPillarItem[] AiPillars => IsTr
        ? [
            new("Strateji & Yol Haritası", "Kurumsal YZ Olgunluk Analizi ve ROI Planlama",
                "Departmanlarınızın veri yapısını ve iş akışlarını inceleyerek yapay zekanın en hızlı ve ölçülebilir katma değer üreteceği senaryoları önceliklendiriyoruz.",
