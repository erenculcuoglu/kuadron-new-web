@page "/blog"
@inject SiteDataService SiteData

<PageMeta Title="Blog | Kuadron Bilişim Teknolojileri"
          Description="İş yazılımları, ERP, CRM, dijital dönüşüm, veri analitiği ve kurumsal teknoloji rehberleri."
          CanonicalPath="/blog/" />

<PageHero Lang="tr"
          Eyebrow="Kuadron Blog"
          Title="Teknoloji, Dijital Dönüşüm ve İş Yazılımları"
          Lead="ERP, CRM, veri hazırlama, bayi otomasyonu ve kurumsal yazılım mimarileri üzerine güncel rehber ve analizlerimiz." />

<section class="py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Search & Tag Navigation Bar -->
        <div class="k-card mb-10 p-5 sm:p-6">
            <div class="relative">
                <label for="blog-search" class="visually-hidden">Blog yazılarında ara</label>
                <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-[var(--text-muted)]">
                    <Icon Name="search" Class="h-5 w-5" />
                </span>
                <input type="search"
                       id="blog-search"
                       autocorrect="off"
                       autocapitalize="off"
                       spellcheck="false"
                       placeholder="Blog yazılarında ara (örn: ERP, CRM, KOSGEB, Endüstri 4.0, Bayi Otomasyon)..."
                       class="k-input !pl-11" />
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-2">
                <span class="font-mono text-xs font-semibold text-[var(--text-muted)]">Etiketler:</span>
                @foreach (var tag in PopularTags)
                {
                    <a href="@($"/blog/tag/{Uri.EscapeDataString(tag.Slug)}")"
                       class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-subtle)] px-3 py-1 text-xs font-semibold text-[var(--text-secondary)] transition-colors hover:border-[var(--brand-amber)] hover:text-[var(--text-primary)]">
                        #@tag.Label
                    </a>
                }
            </div>
        </div>

        <!-- Featured Latest Article -->
        @if (FeaturedPost is not null)
        {
            <article data-blog-card
                     data-search="@($"{FeaturedPost.Title} {FeaturedPost.Description} {string.Join(" ", FeaturedPost.Tags.Select(t => t.Label))}".ToLowerInvariant())"
                     class="k-card k-card-hover mb-12 overflow-hidden">
                <div class="grid grid-cols-1 items-center lg:grid-cols-12">
                    <a href="@($"/blog/{FeaturedPost.Id}")"
                       class="block h-full overflow-hidden border-b border-[var(--border-subtle)] bg-[var(--bg-subtle)] lg:col-span-7 lg:border-r lg:border-b-0">
                        <img src="@FeaturedPost.CoverImage"
                             alt="@FeaturedPost.Title"
                             fetchpriority="high"
                             width="840"
                             height="480"
                             class="aspect-[16/10] h-full w-full object-cover" />
                    </a>

                    <div class="p-6 sm:p-10 lg:col-span-5">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="rounded-full bg-[var(--brand-amber-bg)] px-3 py-1 font-mono text-xs font-bold text-[var(--brand-amber-text)]">
                                Öne Çıkan Yazı
                            </span>
                            @foreach (var t in FeaturedPost.Tags.Take(2))
                            {
                                <a href="@($"/blog/tag/{Uri.EscapeDataString(t.Slug)}")"
                                   class="rounded-full border border-[var(--border-subtle)] bg-[var(--bg-subtle)] px-3 py-1 text-xs font-medium text-[var(--text-secondary)] hover:border-[var(--brand-amber)]">
                                    #@t.Label
                                </a>
                            }
                        </div>

                        <h2 class="mt-4 text-2xl font-extrabold leading-snug text-[var(--text-primary)] sm:text-3xl">
                            <a href="@($"/blog/{FeaturedPost.Id}")" class="hover:text-[var(--brand-sky)]">
                                @FeaturedPost.Title
                            </a>
                        </h2>

                        <p class="mt-3 line-clamp-3 text-base leading-relaxed text-[var(--text-secondary)]">
                            @FeaturedPost.Description
                        </p>

                        <div class="mt-6 flex items-center justify-between border-t border-[var(--border-subtle)] pt-5">
                            <div class="flex items-center gap-3">
                                <img src="@FeaturedPost.AuthorAvatar"
                                     alt="@FeaturedPost.Author"
                                     width="36"
                                     height="36"
                                     class="h-9 w-9 rounded-full border border-[var(--border-subtle)] object-cover" />
                                <div class="text-xs">
                                    <p class="font-bold text-[var(--text-primary)]">@FeaturedPost.Author</p>
                                    <p class="text-[var(--text-muted)]">
                                        @FeaturedPost.DisplayDate • @FeaturedPost.ReadingTime dk okuma
                                    </p>
                                </div>
                            </div>

                            <a href="@($"/blog/{FeaturedPost.Id}")"
                               class="inline-flex items-center gap-1.5 text-sm font-bold text-[var(--brand-sky)] hover:text-[var(--brand-amber-text)]">
                                <span>Oku</span>
                                <Icon Name="arrow-right" Class="h-4 w-4" />
                            </a>
                        </div>
                    </div>
                </div>
            </article>
        }

        <!-- All Blog Articles Grid -->
        <div id="blog-grid" class="grid grid-cols-1 gap-7 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var post in RemainingPosts)
            {
                <article data-blog-card
                         data-search="@($"{post.Title} {post.Description} {string.Join(" ", post.Tags.Select(t => t.Label))}".ToLowerInvariant())"
                         class="k-card k-card-hover flex flex-col justify-between overflow-hidden">
                    <div>
                        <a href="@($"/blog/{post.Id}")"
                           class="block aspect-[16/10] overflow-hidden border-b border-[var(--border-subtle)] bg-[var(--bg-subtle)]">
                            <img src="@post.CoverImage"
                                 alt="@post.Title"
                                 loading="lazy"
                                 width="480"
                                 height="300"
                                 class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" />
                        </a>

                        <div class="p-6">
                            <div class="flex flex-wrap items-center gap-2 text-xs text-[var(--text-muted)]">
                                <span class="inline-flex items-center gap-1">
                                    <Icon Name="calendar" Class="h-3.5 w-3.5" />
                                    @post.DisplayDate
                                </span>
                                <span aria-hidden="true">•</span>
                                <span class="inline-flex items-center gap-1">
                                    <Icon Name="clock" Class="h-3.5 w-3.5" />
                                    @post.ReadingTime dk okuma
                                </span>
                            </div>

                            <h2 class="mt-3 line-clamp-2 text-xl font-bold leading-snug text-[var(--text-primary)]">
                                <a href="@($"/blog/{post.Id}")" class="hover:text-[var(--brand-sky)]">
                                    @post.Title
                                </a>
                            </h2>

                            <p class="mt-2.5 line-clamp-3 text-sm leading-relaxed text-[var(--text-secondary)]">
                                @post.Description
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center justify-between border-t border-[var(--border-subtle)] px-6 py-4">
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var t in post.Tags.Take(2))
                            {
                                <a href="@($"/blog/tag/{Uri.EscapeDataString(t.Slug)}")"
                                   class="rounded-md bg-[var(--bg-subtle)] px-2 py-0.5 text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)]">
                                    #@t.Label
                                </a>
                            }
                        </div>

                        <a href="@($"/blog/{post.Id}")"
                           class="inline-flex shrink-0 items-center gap-1 text-sm font-bold text-[var(--brand-sky)] hover:text-[var(--brand-amber-text)]">
                            <span>Devamı</span>
                            <Icon Name="arrow-right" Class="h-4 w-4" />
                        </a>
                    </div>
                </article>
            }
        </div>

        <p id="blog-empty"
           class="mt-8 hidden rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-8 text-center text-sm font-medium text-[var(--text-muted)]">
            Aramanızla eşleşen blog yazısı bulunamadı.
        </p>
    </div>
</section>

<ContactSection Lang="tr" />

@code {
    private IReadOnlyList<BlogPostEntry> AllPosts => SiteData.BlogPosts;
    private BlogPostEntry? FeaturedPost => AllPosts.FirstOrDefault();
    private IEnumerable<BlogPostEntry> RemainingPosts => AllPosts.Skip(1);
    private IReadOnlyList<(string Slug, string Label, int Count)> PopularTags => SiteData.GetPopularTags(14);
}

