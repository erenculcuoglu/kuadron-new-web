@page "/"
@page "/en"
@inject SiteDataService SiteData
@inject NavigationManager Navigation

<PageMeta Title="@H.MetaTitle" Description="@H.MetaDescription" />

<!-- HomeHero -->
<section class="home-hero" aria-labelledby="home-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="hero-layout">
            <div class="hero-copy">
                <h1 id="home-title"><span class="hero-title-main">@H.HeroTitleLine1</span> <span>@H.HeroTitleHighlight</span></h1>
                <p class="hero-lead">@H.HeroSubtitle</p>
                <div class="hero-actions">
                    <a href="@Nav.CtaHref" class="k-btn-amber">@Nav.CtaButton<Icon Name="arrow-right" Class="h-4 w-4" /></a>
                </div>
            </div>
            <div class="hero-portfolio" aria-labelledby="portfolio-title">
                <h2 id="portfolio-title" class="section-label">@H.ProductsEyebrow</h2>
                <div class="hero-portfolio-grid">
                    @foreach (var product in Portfolio)
                    {
                        var cardClass = $"hero-portfolio-card{(product.IsNew ? " hero-portfolio-new" : "")}{(product.Id == "ozbi" ? " hero-portfolio-flagship" : "")}";
                        <a href="@($"#{product.Id}")" class="@cardClass" data-portfolio-product="@product.Id">
                            <span class="hero-portfolio-status">@product.StatusBadge</span>
                            <strong>@product.Name</strong>
                            <span class="hero-portfolio-tagline">@product.Tagline</span>
                            <Icon Name="arrow-right" Class="hero-portfolio-arrow h-4 w-4" />
                        </a>
                    }
                </div>
            </div>
        </div>
        <dl class="hero-facts">
            @foreach (var stat in H.Stats)
            {
                <div><dt>@stat.Label</dt><dd>@stat.Value</dd></div>
            }
        </dl>
    </div>
</section>

<!-- HomeServices -->
<section id="cozumler" class="home-services py-16 sm:py-24" aria-labelledby="services-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="services-layout">
            <div>
                <p class="section-label">@H.ServicesEyebrow</p>
                <h2 id="services-title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">@H.ServicesTitle</h2>
                <p class="mt-5 max-w-md leading-relaxed text-[var(--text-secondary)]">@H.ServicesDescription</p>
            </div>
            <div class="service-list">
                @for (int index = 0; index < Nav.ServicesItems.Count; index++)
                {
                    var service = Nav.ServicesItems[index];
                    <a href="@service.Href" class="service-row">
                        <span class="service-number" aria-hidden="true">@($"0{index + 1}")</span>
                        <span><h3>@service.Label</h3><p>@service.Desc</p></span>
                        <Icon Name="arrow-right" Class="h-5 w-5 shrink-0" />
                    </a>
                }
            </div>
        </div>

        <div class="capability-groups" role="region" aria-label="@(Lang == "tr" ? "Çalışma alanlarımız" : "Our capabilities")">
            @foreach (var group in GetCapabilityGroups())
            {
                <div class="capability-group">
                    <div class="capability-group-head">
                        <h3 class="capability-group-title">@group.Title</h3>
                    </div>
                    <ul class="capability-items">
                        @foreach (var service in group.Items)
                        {
                            <li class="capability-item">
                                <Icon Name="@service.Icon" Class="capability-icon" />
                                <div class="capability-copy">
                                    <span class="capability-category">@service.Category</span>
                                    <strong class="capability-title">@service.Title</strong>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

<!-- HomeApproach -->
<section class="editorial-section approach-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeading Eyebrow="@H.PillarsEyebrow" Title="@H.PillarsTitle" Description="@H.PillarsDescription" />
        <div class="approach-grid">
            @foreach (var pillar in H.Pillars)
            {
                <article class="approach-item">
                    <Icon Name="@pillar.Icon" Class="h-6 w-6 text-[var(--brand-primary)]" />
                    <h3>@pillar.Title</h3>
                    <p>@pillar.Description</p>
                </article>
            }
        </div>
    </div>
</section>

<!-- HomeProducts -->
<section id="urunler" class="editorial-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeading Eyebrow="@H.ProductsEyebrow"
                        Title="@H.ProductsTitle"
                        Description="@H.ProductsSubtitle"
                        Href="@($"{H.ViewAllProductsHref}#urunler")"
                        LinkLabel="@H.ViewAllProductsLabel" />
        <ProductShowcase Products="@Portfolio" Lang="@Lang" />
    </div>
</section>

<!-- HomeProjects -->
<section id="@H.ProjectsAnchor" class="editorial-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeading Eyebrow="@H.ProjectsEyebrow"
                        Title="@H.ProjectsTitle"
                        Description="@H.ProjectsSubtitle"
                        Href="@H.ViewAllProjectsHref"
                        LinkLabel="@H.ViewAllProjectsLabel" />
        <div class="project-grid">
            @foreach (var project in Content.Projects.Where(p => p.FeaturedOnHome))
            {
                <article class="editorial-story">
                    <img src="@(!string.IsNullOrEmpty(project.HomeImage) ? project.HomeImage : project.Image)"
                         alt="@($"{project.Client} — {project.Title}")"
                         width="720"
                         height="460"
                         decoding="async"
                         class="story-image" />
                    <p class="section-label">@project.Client</p>
                    <h3>@project.Title</h3>
                    <p class="section-description">@project.Description</p>
                    <ul class="story-tags" role="list">
                        @foreach (var feature in project.Features)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                    @if (!string.IsNullOrEmpty(project.Url))
                    {
                        <a href="@project.Url" target="_blank" rel="noopener noreferrer" class="editorial-link">
                            @project.CtaLabel<Icon Name="external" Class="h-4 w-4" />
                        </a>
                    }
                </article>
            }
        </div>
    </div>
</section>

<!-- Testimonials -->
<TestimonialsSection Eyebrow="@H.TestimonialsEyebrow"
                     Title="@H.TestimonialsTitle"
                     Testimonials="@Content.Testimonials"
                     PrevLabel="@(Lang == "tr" ? "Önceki müşteri yorumu" : "Previous testimonial")"
                     NextLabel="@(Lang == "tr" ? "Sonraki müşteri yorumu" : "Next testimonial")" />

<!-- FeaturedNewsSection -->
<FeaturedNewsSection Lang="@Lang" />

<ContactSection Lang="@Lang" />

@code {
    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;
    private string Lang => SiteData.DetectLocale(CurrentPath);
    private LocaleSiteContent Content => SiteData.GetLocale(Lang);
    private HomeContent H => Content.Home;
    private NavContent Nav => Content.Nav;
    private List<ProductItem> Portfolio => Content.Products.Where(p => p.FeaturedOnHome).ToList();

    private sealed record CapabilityGroup(string Title, List<ServiceCapabilityItem> Items);

    private List<CapabilityGroup> GetCapabilityGroups()
    {
        var specs = new (string Title, string[] Icons)[]
        {
            (Lang == "tr" ? "Kurumsal İş Sistemleri" : "Enterprise Business Systems", ["layers", "users", "network", "briefcase"]),
            (Lang == "tr" ? "Özel Mühendislik & Bulut" : "Custom Engineering & Cloud", ["code", "smartphone", "cloud", "rocket"]),
            (Lang == "tr" ? "Strateji, Kalite & Dönüşüm" : "Strategy, Quality & Transformation", ["compass", "award", "building"])
        };

        var used = new HashSet<ServiceCapabilityItem>();
        var groups = specs.Select(spec =>
        {
            var items = new List<ServiceCapabilityItem>();
            foreach (var icon in spec.Icons)
            {
                foreach (var item in H.ServiceList)
                {
                    if (item.Icon == icon && used.Add(item))
                    {
                        items.Add(item);
                    }
                }
            }
            return new CapabilityGroup(spec.Title, items);
        }).ToList();

        foreach (var rem in H.ServiceList.Where(i => !used.Contains(i)))
        {
            groups[^1].Items.Add(rem);
        }

        return groups;
    }
}

