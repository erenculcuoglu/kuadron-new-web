@page "/404"

<PageMeta Title="Sayfa Bulunamadı (404) | Kuadron Bilişim Teknolojileri"
          Description="Aradığınız sayfa taşınmış veya kaldırılmış olabilir." />

<section class="py-24 sm:py-32">
    <div class="mx-auto max-w-2xl px-4 text-center sm:px-6">
        <span class="inline-flex items-center rounded-full bg-[var(--brand-amber-bg)] px-4 py-1.5 font-mono text-sm font-bold text-[var(--brand-amber-text)]">
            404 • Not Found
        </span>
        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl">
            Aradığınız sayfa bulunamadı
        </h1>
        <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)]">
            Sayfa adresi değişmiş olabilir. Ana sayfaya dönebilir veya çözümlerimizi inceleyebilirsiniz.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a href="/" class="k-btn-primary">
                <span>Ana Sayfaya Dön</span>
                <Icon Name="arrow-right" Class="h-4 w-4" />
            </a>
            <a href="/en/" class="k-btn-secondary">
                <span>English Home</span>
            </a>
        </div>
    </div>
</section>

