@page "/urun-gelistirme"
@page "/en/product-development"
@inject SiteDataService SiteData
@inject NavigationManager Navigation

<PageMeta Title="@P.MetaTitle" Description="@P.MetaDescription" />

<PageHero Lang="@Lang" Eyebrow="@P.Eyebrow" Title="@P.Title" Lead="@P.Lead" Steps="@P.Steps" />

<section id="urunler" class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeading Eyebrow="SaaS & Cloud" Title="@P.ProductsTitle" />
        <ProductShowcase Products="@Content.Products" Lang="@Lang" />
    </div>
</section>

<FeaturedNewsSection Lang="@Lang" />
<ContactSection Lang="@Lang" />

@code {
    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;
    private string Lang => SiteData.DetectLocale(CurrentPath);
    private LocaleSiteContent Content => SiteData.GetLocale(Lang);
    private ProductDevContent P => Content.ProductDev;
}

