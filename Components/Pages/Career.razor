@page "/kariyer"
@page "/en/career"
@inject SiteDataService SiteData
@inject NavigationManager Navigation

<PageMeta Title="@Kr.MetaTitle" Description="@Kr.MetaDescription" />

<PageHero Lang="@Lang" Eyebrow="@Kr.Eyebrow" Title="@Kr.Title" Lead="@Kr.HrDescription" />

<!-- Open Positions -->
<section class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
            <div>
                <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--brand-amber-text)]">
                    @Kr.Subtitle
                </span>
                <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl">
                    @Kr.OpenPositionsTitle
                </h2>
            </div>

            <button type="button"
                    data-open-dialog="career-apply-dialog"
                    class="k-btn-amber">
                <span>@Kr.CvCtaButton</span>
                <Icon Name="arrow-right" Class="h-4 w-4" />
            </button>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var pos in Kr.Positions)
            {
                <article class="k-card k-card-hover flex flex-col justify-between p-6 sm:p-7">
                    <div>
                        <div class="flex items-center justify-between gap-2">
                            <span class="rounded-full bg-[var(--brand-amber-bg)] px-3 py-1 font-mono text-xs font-semibold text-[var(--brand-amber-text)]">
                                @pos.Badge
                            </span>
                            <Icon Name="briefcase" Class="h-5 w-5 text-[var(--text-muted)]" />
                        </div>

                        <h3 class="mt-5 text-xl font-extrabold text-[var(--text-primary)]">@pos.Title</h3>
                        <p class="mt-2 flex items-center gap-1.5 text-sm font-medium text-[var(--text-secondary)]">
                            <Icon Name="map-pin" Class="h-4 w-4 text-[var(--brand-amber-text)]" />
                            <span>@pos.Location</span>
                        </p>
                    </div>

                    <div class="mt-7 flex flex-wrap items-center gap-3 border-t border-[var(--border-subtle)] pt-4">
                        <button type="button"
                                data-open-dialog="career-apply-dialog"
                                data-position-title="@pos.Title"
                                class="inline-flex cursor-pointer items-center gap-1.5 text-sm font-bold text-[var(--brand-sky)] hover:text-[var(--brand-amber-text)]">
                            <span>@Kr.CvCtaButton</span>
                            <Icon Name="arrow-right" Class="h-4 w-4" />
                        </button>

                        @if (!string.IsNullOrEmpty(pos.ExternalUrl))
                        {
                            <a href="@pos.ExternalUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="ml-auto inline-flex items-center gap-1 text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--text-primary)]">
                                <span>LinkedIn</span>
                                <Icon Name="external" Class="h-3.5 w-3.5" />
                            </a>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<!-- Human Resources Policy -->
<section class="border-y border-[var(--border-subtle)] bg-[var(--bg-subtle)] py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-6">
                <h2 class="text-2xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl">
                    @Kr.HrTitle
                </h2>
                <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
                    @Kr.HrDescription
                </p>

                <ul class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
                    @foreach (var tr in Kr.HrTraits)
                    {
                        <li class="flex items-center gap-2.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-4 py-3 text-sm font-semibold text-[var(--text-primary)]">
                            <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[var(--brand-amber-bg)] text-[var(--brand-amber-text)]">
                                <Icon Name="check" Class="h-3.5 w-3.5" />
                            </span>
                            <span>@tr</span>
                        </li>
                    }
                </ul>
            </div>

            <div class="lg:col-span-6">
                <div class="overflow-hidden rounded-2xl border border-[var(--border-subtle)] shadow-lg">
                    <img src="@Kr.HrImage"
                         alt="@Kr.HrTitle"
                         loading="lazy"
                         width="680"
                         height="480"
                         class="aspect-[4/3] w-full object-cover" />
                </div>
            </div>
        </div>

        <!-- CV Submission CTA Card -->
        <div class="mt-14 rounded-3xl border border-[#1e2f4a] bg-[#0b1424] p-8 text-white sm:p-12">
            <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
                <div>
                    <h3 class="text-2xl font-extrabold text-white sm:text-3xl">@Kr.CvCtaTitle</h3>
                    <p class="mt-2 text-base text-slate-300">@Kr.CvCtaSubtitle</p>
                </div>
                <button type="button"
                        data-open-dialog="career-apply-dialog"
                        class="k-btn-amber shrink-0">
                    <span>@Kr.CvCtaButton</span>
                    <Icon Name="arrow-right" Class="h-4 w-4" />
                </button>
            </div>
        </div>
    </div>
</section>

<FeaturedNewsSection Lang="@Lang" />
<ContactSection Lang="@Lang" />

<ApplicationModal DialogId="career-apply-dialog"
                  Lang="@Lang"
                  Title="@Kr.CvCtaTitle"
                  Subtitle="@Kr.CvCtaSubtitle"
                  FallbackEmail="@Company.Email"
                  JotformUrl="@Company.Jotform.Career"
                  ExtraFieldLabel="@(Lang == "tr" ? "Başvurulan Pozisyon" : "Position Applied For")"
                  ExtraFieldName="position"
                  ExtraFieldPlaceholder="@(Lang == "tr" ? "Örn: Full-Stack Developer" : "e.g. Full-Stack Developer")" />

@code {
    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;
    private string Lang => SiteData.DetectLocale(CurrentPath);
    private CareerContent Kr => SiteData.GetLocale(Lang).Career;
    private CompanyInfoModel Company => SiteData.Company;
}

